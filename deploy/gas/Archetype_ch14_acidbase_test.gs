ARCHETYPES_TEST["ch14_acidbase"] = {"contract": 3, "archetype_id": "ch14_acidbase", "title": "Acids and bases: how far a weak acid or base ionises", "relation": "Ka and Kb are equilibrium constants for the transfer of one proton to or from water; pH = -log[H3O+]", "notebook_url": "https://notebook.google.com/notebook/6458f208-db32-496a-8088-fe0c1c6cd539", "kinds": ["weak_acid", "weak_base"], "mechanism_words": ["molecul", "particl", "ion", "proton", "transfer", "donat", "accept", "collid", "collis", "water", "hydronium", "hydroxide", "forward", "reverse", "rate", "equal", "fraction", "percent", "dissociat", "ioniz", "ionis", "some", "few", "most", "all of", "excess", "left over", "neutral"], "equation_picks": [{"id": "eq_ph", "text": "\\( \\mathrm{pH} = -\\log[\\mathrm{H_3O^+}] \\)", "fits": []}, {"id": "eq_ka", "text": "\\( K_a = \\dfrac{[\\mathrm{H_3O^+}][\\mathrm{A^-}]}{[\\mathrm{HA}]} \\)", "fits": ["weak_acid"]}, {"id": "eq_kb", "text": "\\( K_b = \\dfrac{[\\mathrm{BH^+}][\\mathrm{OH^-}]}{[\\mathrm{B}]} \\)", "fits": ["weak_base"]}, {"id": "eq_hh", "text": "\\( \\mathrm{pH} = \\mathrm{p}K_a + \\log\\dfrac{[\\mathrm{A^-}]}{[\\mathrm{HA}]} \\)", "fits": []}, {"id": "eq_kw", "text": "\\( K_w = [\\mathrm{H_3O^+}][\\mathrm{OH^-}] \\)", "fits": []}, {"id": "eq_kakb", "text": "\\( K_a K_b = K_w \\)", "fits": []}, {"id": "eq_k", "text": "\\( K = \\dfrac{[\\mathrm{C}]^{c}[\\mathrm{D}]^{d}}{[\\mathrm{A}]^{a}[\\mathrm{B}]^{b}} \\)", "fits": []}, {"id": "eq_g", "text": "\\( \\Delta G^\\circ = -RT \\ln K \\)", "fits": []}, {"id": "eq_excess", "text": "\\( [\\mathrm{H_3O^+}] \\text{ or } [\\mathrm{OH^-}] = \\dfrac{\\text{moles in excess}}{\\text{total volume}} \\)", "fits": []}], "trap_notes": {"SQRT_FORGOTTEN": {"note": "Their x is K × c: the square root was not taken.", "ask": "If x times x equals K times c, what is x itself?"}, "PH_FROM_FORMAL_CONCENTRATION": {"note": "Their pH treats the weak acid or base as strong, as if every molecule ionized.", "ask": "Did every molecule of {substance} give up its proton? What does x stand for?"}, "PKA_TYPED_AS_PH": {"note": "Their pH is −log K, not the pH.", "ask": "You took the logarithm of K. The pH comes from which concentration?"}, "PERCENT_AS_FRACTION": {"note": "Their percent is the fraction x ÷ c, not yet multiplied by 100.", "ask": "That is a fraction. What do you multiply it by to make a percent?"}, "SMALL_X_WHEN_IT_FAILS": {"note": "They dropped x, but more than 5 % ionized, so that value is off.", "ask": "What percent does your x give? Is that below 5 %? If not, which method do you need?"}, "POH_TYPED_AS_PH": {"note": "For a base, their pH is the pOH: the step from pOH to pH (14.00 − pOH) was skipped.", "ask": "x is the hydroxide concentration. Does −log x give the pH or the pOH? What is left to do?"}, "IONS_PER_FORMULA_IGNORED": {"note": "Their ion concentration equals the formula concentration though each unit gives more than one ion.", "ask": "How many hydroxide ions does one formula unit release?"}, "RATIO_INVERTED": {"note": "Their value uses acid over base.", "ask": "Which concentration goes on top in the relation you picked?"}, "LOG_FORGOTTEN": {"note": "Their pH adds the ratio itself to pKa, without the logarithm.", "ask": "What operation sits between pKa and the ratio?"}, "EXCEEDS_INITIAL": {"note": "Their x is larger than the starting concentration, which cannot be.", "ask": "Can more acid ionize than was put in? Check the algebra."}, "WATER_IN_EXPRESSION": {"note": "Water is written into the expression.", "ask": "Water is the solvent. Does it go into K?"}, "DILUTION_IONIZATION_FALLS": {"note": "They predicted the percent ionized falls on dilution.", "ask": "Spread out, do the ions meet to take protons back more often, or less often?"}, "CONJUGATE_LOWERS_PH": {"note": "They predicted the pH falls when the acid's conjugate base is added.", "ask": "The added ion is a base. Does it take protons from hydronium, or give them?"}, "CONJUGATE_RAISES_PH": {"note": "They predicted the pH rises when the base's conjugate acid is added.", "ask": "The added ion is an acid. Does it give protons to hydroxide, or take them?"}, "BUFFER_PH_FIXED": {"note": "They predicted no change at all after strong acid or base was added.", "ask": "Something was consumed. Did the ratio of base to acid stay exactly the same?"}, "ADDED_NOT_CONSUMED": {"note": "Their new pH treats the added acid or base as if it stayed free in the buffer.", "ask": "What does the added hydroxide meet first in this solution, and what becomes of it?"}, "PH_7_AT_EQUIVALENCE": {"note": "They gave pH 7 at the equivalence point of a weak acid.", "ask": "What is in the flask at equivalence, and does that ion leave water alone?"}, "VOLUME_NOT_TOTALED": {"note": "Their concentration divides by the original volume, not the total after titrant was added.", "ask": "How much liquid is in the flask now?"}, "KA_FOR_HYDROLYSIS": {"note": "Their x at equivalence comes from Ka, but the species there is the conjugate base.", "ask": "Which constant belongs to the conjugate base reacting with water?"}, "HH_AT_EQUIVALENCE": {"note": "They used Henderson-Hasselbalch where no acid is left.", "ask": "How much of the acid is left for the ratio?"}, "MOLES_FROM_ONE_SOLUTION": {"note": "Their moles ignore one of the two solutions.", "ask": "Which solution supplied the moles you just counted, and which did you leave out?"}, "CHANGE_SIGNS_REVERSED": {"note": "The change row runs the wrong way: the acid gains and the ions lose.", "ask": "Which species start at zero? Can their change be negative?"}, "WATER_IN_TABLE": {"note": "The table has a column for water.", "ask": "Water is the solvent, and its concentration barely changes. Does it need a column?"}}, "trap_notes_by_opener": {"The Bleach Puzzle": {"KA_USED_AS_KB": {"note": "Their Kb is the partner acid's Ka, typed as it stands.", "ask": "Ka and Kb of a conjugate pair are not the same number. What do they multiply to?"}}}, "equation_symbols": {"x": ["x"], "K": ["Ka", "K_a", "Kb", "K_b", "K"]}, "equation_constants": {"Kw": 1e-14}, "openers": [{"title": "Same Label, Different pH", "question": "In the stockroom, the student worker lines up two bottles. Both labels say 2.0 M. One is hydrochloric acid. The other is acetic acid, the acid in vinegar. Her pH meter reads −0.30 for the hydrochloric acid but 2.22 for the acetic acid. That is more than 300 times less hydronium. Same label, very different pH. Which species are present in each bottle, and which ones dominate?", "model_answer": "HCl: H₃O⁺ and Cl⁻ only (complete ionization). CH₃COOH: weak; Ka = 1.8 × 10⁻⁵; about 0.3 % ionized; molecular CH₃COOH dominates; H₃O⁺ and CH₃COO⁻ minor. Proton transfer both ways at equal rates.", "target": "A weak acid ionizes only partly: proton transfer runs both ways and settles at an equilibrium set by Ka, so [H₃O⁺] is far less than the acid's concentration; the fraction ionized grows on dilution.", "keywords": ["weak acid", "partial ionization", "few", "molecular acetic acid", "whole molecules", "equilibrium", "Ka"], "liquids": ["K1", "K2", "K3", "K4", "K5", "K6"], "kinds": ["weak_acid", "weak_base"], "fits": ["K1", "K2", "K3", "K4", "K5", "K6"], "media": {"image_with_question": "ch14_acidbase/same_label_different_ph_visual.png", "image_after_account": "", "image_alt": "A stockroom bench in warm light: two clear bottles labeled 2.0 M HCl and 2.0 M CH₃COOH (acetic acid). A pH probe sits in the acetic acid; the meter beside them reads 2.22.", "simulation": "ch14_acidbase/weak_acid_base_simulator.html?species={species}&c={c}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with NotebookLM"}, "label_words": ["weak acid", "strong acid", "equilibrium", "dynamic equilibrium", "ionization", "pH", "Ka"], "role": "worked", "items": {"add": [], "remove": []}}, {"title": "The Fishy Bowl", "question": "Fish that is no longer fresh smells \"fishy\". The smell is trimethylamine, a weak base that escapes from the fish into the air. A cook rinses the fish in a bowl of water. A pH probe in the rinse water reads about 11, and an amine sensor held above the bowl beeps. She squeezes lemon juice into the bowl. The sensor goes quiet, and the smell fades. Which trimethylamine species dominate before and after the lemon juice, and why does the smell fade?", "model_answer": "Before: (CH₃)₃N, weak base, Kb = 6.3 × 10⁻⁵; molecular amine dominates; it is volatile (smell). After: H₃O⁺ protonates the amine to (CH₃)₃NH⁺; the ion is not volatile; the smell fades.", "target": "A weak base takes protons from water only partly, at an equilibrium set by Kb: x is [OH⁻], so the pOH comes first, then the pH. Adding acid turns the base into its conjugate acid.", "keywords": ["weak base", "partial ionization", "few", "protonation", "takes a proton", "volatile", "escapes", "ammonium ion", "ion"], "liquids": ["X1", "X2", "X3", "X4", "X5", "X6"], "kinds": ["weak_base"], "fits": ["X1", "X2", "X3", "X4", "X5", "X6"], "media": {"image_with_question": "ch14_acidbase/Fishy_bowl.jpg", "image_after_account": "", "image_alt": "A kitchen sink: a whole fresh fish in a glass bowl of water, a hand squeezing lemon juice into it, a pH probe in the water with its meter reading 11.0, and a handheld gas sensor with its light on, held above the bowl.", "simulation": "ch14_acidbase/weak_acid_base_simulator.html?species={species}&c={c}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with NotebookLM"}, "label_words": ["weak base", "base", "equilibrium", "dynamic equilibrium", "Kb", "pH", "basic"], "role": "exam", "items": {"add": [], "remove": []}}, {"title": "The Weak Acid That Eats Glass", "question": "Hydrofluoric acid is a weak acid. A pH meter in 0.10 M hydrofluoric acid reads 2.11; in 0.10 M hydrochloric acid it reads 1.00. Yet hydrofluoric acid is kept in plastic bottles because it etches glass, and it is one of the most dangerous acids in any lab. Hydrochloric acid does not touch glass. Which species dominate in the hydrofluoric acid solution, and which of them attacks the glass?", "model_answer": "HF is weak: Ka 6.4 × 10⁻⁴ (Appendix H); in 0.10 M about 7.7 % ionized, so molecular HF dominates; H₃O⁺ and F⁻ are minor. Glass (SiO₂) reacts with HF: SiO₂ + 4HF → SiF₄ + 2H₂O. \"Weak\" describes partial ionization, not hazard; the danger comes from HF and fluoride, not from hydronium.", "target": "A weak acid ionizes only partly, so molecular HA dominates; 'weak' describes ionization, not hazard.", "keywords": ["weak acid", "partial ionization", "few", "molecular HF", "whole molecules", "equilibrium", "Ka", "etch", "silicon dioxide"], "liquids": ["H1", "H2", "H3", "H4", "H5", "H6"], "kinds": ["weak_acid"], "fits": ["H1", "H2", "H3", "H4", "H5", "H6"], "media": {"image_with_question": "ch14_acidbase/Eats_glass.jpg", "image_after_account": "", "image_alt": "A lab bench: a plastic bottle labeled 0.10 M HF, an etched glass slide beside it, and a pH probe in a plastic beaker with its meter reading 2.11.", "simulation": "ch14_acidbase/weak_acid_base_simulator.html?species={species}&c={c}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with NotebookLM"}, "label_words": ["weak acid", "strong acid", "equilibrium", "ionization", "pH", "Ka", "corrosive"], "role": "floater", "items": {"add": [], "remove": []}}, {"title": "The Bleach Puzzle", "question": "Household bleach is sodium hypochlorite, NaClO. A lab dissolves pure sodium hypochlorite in water at 0.70 M, about the strength of bleach. A pH meter reads 10.7, strongly basic, yet the formula has no OH in it. Sodium hypochlorite contains no hydroxide. Where do the hydroxide ions come from?", "model_answer": "ClO⁻ is the conjugate base of the weak acid HClO (Ka 2.9 × 10⁻⁸, Appendix H). It takes protons from water: ClO⁻ + H₂O ⇌ HClO + OH⁻; Kb = Kw ÷ Ka = 3.4 × 10⁻⁷. Partial: about 0.07 % at 0.70 M; pH 10.7. Na⁺ is a spectator. The weaker the acid, the stronger its conjugate base.", "target": "An anion that is the conjugate base of a weak acid takes protons from water, making hydroxide; Kb = Kw ÷ Ka.", "keywords": ["conjugate base", "takes a proton", "proton transfer", "water", "hydroxide", "hypochlorous acid", "Kb", "Ka", "Kw", "spectator", "partial"], "liquids": ["C1", "C2", "C3", "C4", "C5", "C6"], "kinds": ["weak_base"], "fits": ["C1", "C2", "C3", "C4", "C5", "C6"], "media": {"image_with_question": "ch14_acidbase/Bleach_puzzle.jpg", "image_after_account": "", "image_alt": "A laundry-room shelf: a white jug labeled sodium hypochlorite beside a small beaker with a pH probe; the meter reads 10.70.", "simulation": "ch14_acidbase/weak_acid_base_simulator.html?species={species}&c={c}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with NotebookLM"}, "label_words": ["weak base", "conjugate base", "hydrolysis", "basic salt", "pH", "Kb"], "role": "floater", "items": {"add": [], "remove": []}}], "moves": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "Think about one molecule of {substance} meeting water. Does a proton move? Can it move back?", "notebook_prompt": "I am learning why a weak acid or a weak base ionizes only partly in water. Explain, in terms of protons moving both ways, what a weak acid does in water. Use a substance other than mine. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words, what do the molecules of a weak acid do in water?", "park_text": "A weak acid or base passes protons to or from water in both directions. At equilibrium only a small fraction is ionized; the rest stays whole.", "status": "approved (instructor, 16 Oct 2026)"}, "relation_chosen": {"state": "relation_chosen", "stage": "setup", "label_when_done": "Equilibrium constant chosen", "ask": "Open the Equations list and pick the equilibrium constant that describes {substance} in water.", "switch_ask": "Does {substance} give a proton to water, or take one from it? Which constant, Ka or Kb, describes that?", "notebook_prompt": "Explain what Ka and Kb describe, and how to tell which one applies to a substance in water. Use examples other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "When do you use Ka, and when Kb?", "park_text": "An acid gives a proton to water: \\( K_a = \\dfrac{[\\mathrm{H_3O^+}][\\mathrm{A^-}]}{[\\mathrm{HA}]} \\). A base takes one from water: \\( K_b = \\dfrac{[\\mathrm{BH^+}][\\mathrm{OH^-}]}{[\\mathrm{B}]} \\). Water is left out.", "status": "approved (instructor, 16 Oct 2026)"}, "table": {"state": "table", "stage": "setup", "label_when_done": "ICE table set up", "ask": "Set up the ICE table: the starting concentrations, the change in terms of x, and the equilibrium row. Leave water out.", "switch_ask": "Which species is there at the start, and which two are made? Which way do their changes go?", "notebook_prompt": "Show me how to set up an ICE table for a weak acid in water. Use a different acid and concentration. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "What does each row of an ICE table hold?", "park_text": "Initial: c, 0, 0. Change: −x, +x, +x. Equilibrium: c − x, x, x. Water has no column.", "status": "approved (instructor, 16 Oct 2026)"}, "expression_set": {"state": "expression_set", "stage": "setup", "label_when_done": "Expression written", "ask": "Put the equilibrium row into the constant's expression. Type the equation with x in it.", "switch_ask": "Which species go on top of the fraction, and which on the bottom?", "notebook_prompt": "Explain how to turn the equilibrium row of an ICE table into the equation for x. Use a different acid. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Where does each entry of the equilibrium row go in the expression?", "park_text": "\\( K = \\dfrac{x \\cdot x}{c - x} \\), with K and c from the problem.", "status": "approved (instructor, 16 Oct 2026)"}, "method": {"state": "method", "stage": "solve", "label_when_done": "Method chosen", "ask": "How will you solve for x? Pick a method.", "switch_ask": "Is K tiny compared with the starting concentration? If x is small, what happens to c − x?", "notebook_prompt": "Explain when you may drop x from c − x in a weak acid problem, and how the 5 % rule checks that choice. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "When may you drop x?", "park_text": "Drop x when K is small next to c, and check afterwards that less than 5 % ionized. If more did, use the quadratic formula.", "status": "approved (instructor, 16 Oct 2026)"}, "x_found": {"state": "x_found", "stage": "solve", "label_when_done": "x found", "ask": "Solve for x. Type it with its unit.", "switch_ask": "If you dropped x, then x times x equals K times c. If not, rearrange to \\( x^{2} + Kx - Kc = 0 \\) and use the quadratic formula. Which positive x leaves c − x above zero?", "notebook_prompt": "Show me how to solve x·x/(c − x) = K for x, both by dropping x and with the quadratic formula. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "What does x stand for in this problem?", "park_text": "If x is small: \\( x = \\sqrt{K c} \\). Otherwise x is the positive root of \\( x^{2} + Kx - Kc = 0 \\).", "status": "approved (instructor, 16 Oct 2026)"}, "pOH_found": {"state": "pOH_found", "stage": "calculate", "label_when_done": "pOH found", "ask": "x is the hydroxide concentration. Find the pOH. Type its value.", "switch_ask": "pOH = −log[OH⁻]. Which concentration is x here?", "notebook_prompt": "Explain how to get the pOH, and then the pH, from the hydroxide concentration of a weak base. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which ion's concentration is x for a base?", "park_text": "\\( \\mathrm{pOH} = -\\log x \\)", "status": "approved (instructor, 16 Oct 2026)"}, "pH_found": {"state": "pH_found", "stage": "calculate", "label_when_done": "pH found", "ask": "Now find the pH. Type its value.", "switch_ask": "For an acid, x is the hydronium concentration. For a base, subtract the pOH from 14.00.", "notebook_prompt": "Show me how to turn x into a pH for a weak acid, and for a weak base. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "How does x become the pH?", "park_text": "Acid: \\( \\mathrm{pH} = -\\log x \\). Base: \\( \\mathrm{pH} = 14.00 - \\mathrm{pOH} \\).", "status": "approved (instructor, 16 Oct 2026)"}, "percent_found": {"state": "percent_found", "stage": "calculate", "label_when_done": "Percent ionized found", "ask": "What percent of the {substance} ionized? Type the percent.", "switch_ask": "Percent ionized compares the part that ionized, x, with what you started with. Multiply the fraction by 100.", "notebook_prompt": "Explain how to calculate the percent ionization of a weak acid, and what it tells you. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What does percent ionized compare?", "park_text": "Percent ionized = x ÷ c × 100.", "status": "approved (instructor, 16 Oct 2026)"}, "approx_checked": {"state": "approx_checked", "stage": "check", "label_when_done": "5 % rule checked", "ask": "Check the 5 % rule. Did dropping x hold, or was the quadratic needed? Pick one.", "switch_ask": "Is your percent ionized below 5 or above it?", "notebook_prompt": "Explain the 5 % rule for weak acid problems, and why it matters. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What does the 5 % rule check?", "park_text": "Below 5 % ionized, dropping x was fine. Above 5 %, the quadratic was needed.", "status": "approved (instructor, 16 Oct 2026)"}, "perturb_1": {"state": "perturb_1", "stage": "change", "label_when_done": "Dilution predicted", "ask": "Take 10.0 mL of this solution and add water until there is 100.0 mL. What happens to the percent ionized: does it rise, fall, or stay the same? Pick one.", "switch_ask": "After the dilution the ions are farther apart. Do they meet to take protons back more often, or less often?", "notebook_prompt": "Explain what diluting a weak acid does to its percent ionization, and why. Use a different acid. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which way does dilution move the percent ionized?", "park_text": "Diluting a weak acid or base raises its percent ionized, although the ion concentration itself falls.", "status": "approved (instructor, 16 Oct 2026)"}, "perturb_1_why": {"state": "perturb_1_why", "stage": "change", "label_when_done": "Dilution explained", "ask": "Explain, in terms of the molecules and ions, why the percent ionized changes.", "switch_ask": "Giving a proton to water needs one molecule and the water around it. Taking a proton back needs two ions to meet. Which one slows down when everything is spread out?", "notebook_prompt": "Explain, in terms of collisions, why a weak acid ionizes to a greater extent when it is diluted. Use a different acid. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Why does dilution slow the reverse reaction more?", "park_text": "Spread out, the ions meet less often to take protons back, while molecules still give protons to the water around them. A larger fraction stays ionized.", "status": "approved (instructor, 16 Oct 2026)"}, "perturb_2": {"state": "perturb_2", "stage": "change", "label_when_done": "Partner ion predicted", "ask": "Start again from the original solution. A spoonful of a salt containing {conjugate} dissolves in it. What happens to the pH: does it rise, fall, or stay the same? Pick one.", "switch_ask": "The salt adds the partner ion that {substance} makes when it ionizes. Which way does that push the equilibrium?", "notebook_prompt": "Explain what adding a weak acid's conjugate base does to the solution's pH, and why. Use a different acid. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which way does adding the partner ion push the equilibrium?", "park_text": "The partner ion pushes the equilibrium back toward the whole acid or base. For an acid, hydronium falls and the pH rises. For a base, hydroxide falls and the pH falls.", "status": "approved (instructor, 16 Oct 2026)"}, "perturb_2_why": {"state": "perturb_2_why", "stage": "change", "label_when_done": "Partner ion explained", "ask": "Explain, in terms of the molecules and ions, why the pH changes.", "switch_ask": "The added partner ions meet hydronium ions, or hydroxide ions for a base. What happens to protons when they meet?", "notebook_prompt": "Explain, in terms of collisions, how adding the conjugate ion of a weak acid shifts its equilibrium. Use a different acid. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What do the added ions do?", "park_text": "The added ions meet hydronium (or hydroxide) ions and the protons move back, so the reverse reaction speeds up until a new equilibrium has less hydronium (or less hydroxide).", "status": "approved (instructor, 16 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "What does Ka tell you about an acid that its concentration alone does not?", "switch_ask": "Two acids at the same concentration: what decides how much hydronium each makes?", "notebook_prompt": "Explain what the size of Ka says about an acid, and why concentration alone does not set the pH of a weak acid. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What does a larger Ka mean?", "status": "approved (instructor, 16 Oct 2026)"}, "reflection": {"state": "reflection", "stage": "close", "label_when_done": "Reflection written", "ask": "Which step was hardest for you? In one sentence, what would you tell a friend who is stuck there?", "status": "approved (instructor, 16 Oct 2026)"}, "Kb_found": {"state": "Kb_found", "ask": "The problem gives Ka for the partner acid. Find Kb for the base from Kw and that Ka.", "switch_ask": "Ka and Kb of a conjugate pair multiply to Kw. Which one do you have, and which one does the table need?", "park_text": "Kb = Kw ÷ Ka", "status": "approved (instructor, 19 Oct 2026: 'yes build'; plain wording by Fable, SCENARIO_CLAUDE may rewrite)"}}, "moves_by_opener": {"Same Label, Different pH": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "Hydrochloric acid gives every proton away. If acetic acid did the same, what would the meter read?", "park_text": "Acetic acid gives protons to water, and acetate takes them back, at equal rates. Only a small fraction is ionized at any moment, so the hydronium is far below 2.0 M.", "status": "approved (instructor, 16 Oct 2026)", "show": "Here is how a chemist would put it: a weak acid's molecules give protons to water, and the ions they leave take protons back, at equal rates. Only a small fraction is ionized at any moment. Now say in your own words what the acetic acid molecules are doing."}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Both bottles said 2.0 M. Why can't you read an acid's pH from its label alone?", "switch_ask": "The label counts all the acid put in. What does the pH count?", "status": "approved (instructor, 16 Oct 2026)", "show": "The label counts all the acid in the bottle. pH counts only the hydronium. A strong acid gives every proton away; a weak acid gives only a small fraction, set by Ka. Now answer in your own words."}, "relation_chosen": {"state": "relation_chosen", "status": "approved (instructor, 16 Oct 2026)", "show": "A weak acid's equilibrium is described by \\( K_a = \\dfrac{[\\mathrm{H_3O^+}][\\mathrm{A^-}]}{[\\mathrm{HA}]} \\). Water is left out: it is the solvent. Pick the Ka expression from the Equations list."}, "table@v:holds": {"state": "table", "status": "approved (instructor, 16 Oct 2026)", "show": "Start: 0.10 M acetic acid, no acetate, no hydronium from the acid. Change: −x, +x, +x. Equilibrium: 0.10 − x, x, x. Fill in the table.", "version": "holds"}, "table@v:fails": {"state": "table", "status": "approved (instructor, 16 Oct 2026)", "show": "Start: 0.00050 M acetic acid, no acetate, no hydronium from the acid. Change: −x, +x, +x. Equilibrium: 0.00050 − x, x, x. Fill in the table.", "version": "fails"}, "expression_set@v:holds": {"state": "expression_set", "status": "approved (instructor, 16 Oct 2026)", "show": "Put the equilibrium row into Ka: \\( 1.8 \\times 10^{-5} = \\dfrac{x \\cdot x}{0.10 - x} \\). Type the equation.", "version": "holds"}, "expression_set@v:fails": {"state": "expression_set", "status": "approved (instructor, 16 Oct 2026)", "show": "Put the equilibrium row into Ka: \\( 1.8 \\times 10^{-5} = \\dfrac{x \\cdot x}{0.00050 - x} \\). Type the equation.", "version": "fails"}, "method@v:holds": {"state": "method", "status": "approved (instructor, 16 Oct 2026)", "show": "Ka is small and the acid is fairly concentrated, so x will be tiny next to 0.10. Drop x from 0.10 − x; you will check this at the end. Pick the small-x method.", "version": "holds"}, "method@v:fails": {"state": "method", "status": "approved (instructor, 16 Oct 2026)", "show": "Here the acid is very dilute. If you drop x, x comes out \\( 9.5 \\times 10^{-5} \\) M, which is 19 % of 0.00050, far more than 5 %. So keep x and use the quadratic formula. Pick the quadratic.", "version": "fails"}, "x_found@v:holds": {"state": "x_found", "status": "approved (instructor, 16 Oct 2026)", "show": "\\( x \\cdot x = 1.8 \\times 10^{-5} \\times 0.10 = 1.8 \\times 10^{-6} \\), so \\( x = 1.3 \\times 10^{-3} \\) M. Type x with its unit.", "version": "holds"}, "x_found@v:fails": {"state": "x_found", "status": "approved (instructor, 16 Oct 2026)", "show": "Multiply out: \\( x^{2} + (1.8 \\times 10^{-5})x - 9.0 \\times 10^{-9} = 0 \\). The quadratic formula gives \\( x = 8.6 \\times 10^{-5} \\) M; the other root is negative. Type x with its unit.", "version": "fails"}, "pH_found@v:holds": {"state": "pH_found", "status": "approved (instructor, 16 Oct 2026)", "show": "x is the hydronium concentration: \\( \\mathrm{pH} = -\\log(1.3 \\times 10^{-3}) = 2.87 \\). Type the pH.", "version": "holds"}, "pH_found@v:fails": {"state": "pH_found", "status": "approved (instructor, 16 Oct 2026)", "show": "\\( \\mathrm{pH} = -\\log(8.6 \\times 10^{-5}) = 4.06 \\). Type the pH.", "version": "fails"}, "percent_found@v:holds": {"state": "percent_found", "status": "approved (instructor, 16 Oct 2026)", "show": "Percent ionized = \\( 1.3 \\times 10^{-3} \\) ÷ 0.10 × 100 = 1.3 %. Type the percent.", "version": "holds"}, "percent_found@v:fails": {"state": "percent_found", "status": "approved (instructor, 16 Oct 2026)", "show": "Percent ionized = \\( 8.6 \\times 10^{-5} \\) ÷ 0.00050 × 100 = 17 %. Type the percent.", "version": "fails"}, "approx_checked@v:holds": {"state": "approx_checked", "status": "approved (instructor, 16 Oct 2026)", "show": "1.3 % is less than 5 %, so dropping x was fine. Pick holds.", "version": "holds"}, "approx_checked@v:fails": {"state": "approx_checked", "status": "approved (instructor, 16 Oct 2026)", "show": "17 % is more than 5 %, so the quadratic was needed. Pick fails.", "version": "fails"}, "perturb_1": {"state": "perturb_1", "status": "approved (instructor, 16 Oct 2026)", "show": "Diluted, the ions are farther apart and meet less often to take protons back, so a larger fraction stays ionized. The percent ionized rises, though the hydronium concentration still falls. Pick the answer."}, "perturb_1_why": {"state": "perturb_1_why", "status": "approved (instructor, 16 Oct 2026)", "show": "Giving a proton to water needs only the molecule and the water around it; taking it back needs two ions to meet. Spreading out slows the second. Now explain it in your own words."}, "perturb_2": {"state": "perturb_2", "status": "approved (instructor, 16 Oct 2026)", "show": "Sodium acetate adds acetate ions, the acid's own partner. More acetate takes protons back from hydronium, so hydronium falls and the pH rises. Pick the answer."}, "perturb_2_why": {"state": "perturb_2_why", "status": "approved (instructor, 16 Oct 2026)", "show": "Extra acetate meets hydronium more often and takes protons back, which pushes the equilibrium toward whole acetic acid. Now explain it in your own words."}, "offer@v:holds": {"state": "offer", "stage": "close", "status": "approved (instructor, 16 Oct 2026)", "show": "Want to see the same problem with one change? The acetic acid is now very dilute, 0.00050 M. Watch what happens to the 5 % rule.", "version": "holds"}}, "The Fishy Bowl": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "Whole trimethylamine molecules can float into the air; ions cannot. Before the lemon, are most of the molecules whole or ionized?", "park_text": "Trimethylamine takes protons from water only partly; most molecules stay whole and can escape as the smell. Acid turns them into ions, which stay in the water.", "status": "approved (instructor, 16 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Why does the lemon juice stop the smell? Answer in terms of the equilibrium between trimethylamine and its ion.", "switch_ask": "Lemon juice adds protons. Which way does that push the base's equilibrium, and what happens to the whole molecules that made the smell?", "notebook_prompt": "Explain how adding an acid to a weak base changes the amounts of the base and its conjugate acid, and why that can stop a smell. Use a base other than mine. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What does adding acid do to a weak base?", "status": "approved (instructor, 16 Oct 2026)"}}, "The Weak Acid That Eats Glass": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "At 7.7 % ionized, which is there more of in the bottle: whole HF molecules, or fluoride ions?", "park_text": "Most HF stays as whole molecules; only a few percent give their proton to water. Whole HF molecules react with the glass.", "status": "approved (instructor, 17 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "What does \"weak\" tell you about an acid, and what does it not tell you?", "switch_ask": "Does Ka say anything about what else the acid's molecules can react with?", "notebook_prompt": "Explain the difference between an acid's strength (how far it ionizes) and how dangerous or reactive it is. Use an example other than mine. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What does \"weak\" describe?", "status": "approved (instructor, 17 Oct 2026)"}}, "The Bleach Puzzle": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "Hypochlorite is the partner of a weak acid. What can it take from a water molecule, and what does the water become?", "park_text": "Hypochlorite takes a proton from water and becomes hypochlorous acid; the water becomes hydroxide. Only a smal