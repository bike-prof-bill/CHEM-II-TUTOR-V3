ARCHETYPES_TEST["ch14_titration"] = {"contract": 3, "archetype_id": "ch14_titration", "title": "Titration: the pH along the curve", "relation": "moles decide the region; each region has its own relation: Ka, Henderson-Hasselbalch, the conjugate's Kb, or the excess over the total volume", "notebook_url": "https://notebook.google.com/notebook/6458f208-db32-496a-8088-fe0c1c6cd539", "kinds": ["weak_start", "weak_before", "weak_at", "weak_after", "strong_before", "strong_at", "strong_after"], "mechanism_words": ["molecul", "particl", "ion", "proton", "transfer", "donat", "accept", "collid", "collis", "water", "hydronium", "hydroxide", "forward", "reverse", "rate", "equal", "fraction", "percent", "dissociat", "ioniz", "ionis", "some", "few", "most", "all of", "excess", "left over", "neutral"], "equation_picks": [{"id": "eq_ph", "text": "\\( \\mathrm{pH} = -\\log[\\mathrm{H_3O^+}] \\)", "fits": ["strong_at"]}, {"id": "eq_ka", "text": "\\( K_a = \\dfrac{[\\mathrm{H_3O^+}][\\mathrm{A^-}]}{[\\mathrm{HA}]} \\)", "fits": ["weak_start"]}, {"id": "eq_kb", "text": "\\( K_b = \\dfrac{[\\mathrm{BH^+}][\\mathrm{OH^-}]}{[\\mathrm{B}]} \\)", "fits": []}, {"id": "eq_hh", "text": "\\( \\mathrm{pH} = \\mathrm{p}K_a + \\log\\dfrac{[\\mathrm{A^-}]}{[\\mathrm{HA}]} \\)", "fits": ["weak_before"]}, {"id": "eq_kw", "text": "\\( K_w = [\\mathrm{H_3O^+}][\\mathrm{OH^-}] \\)", "fits": []}, {"id": "eq_kakb", "text": "\\( K_a K_b = K_w \\)", "fits": ["weak_at"]}, {"id": "eq_k", "text": "\\( K = \\dfrac{[\\mathrm{C}]^{c}[\\mathrm{D}]^{d}}{[\\mathrm{A}]^{a}[\\mathrm{B}]^{b}} \\)", "fits": []}, {"id": "eq_g", "text": "\\( \\Delta G^\\circ = -RT \\ln K \\)", "fits": []}, {"id": "eq_excess", "text": "\\( [\\mathrm{H_3O^+}] \\text{ or } [\\mathrm{OH^-}] = \\dfrac{\\text{moles in excess}}{\\text{total volume}} \\)", "fits": ["weak_after", "strong_before", "strong_after"]}], "trap_notes": {"SQRT_FORGOTTEN": {"note": "At the start their x is Ka × c: the square root was not taken.", "ask": "If x times x equals Ka times c, what is x itself?"}, "PH_FROM_FORMAL_CONCENTRATION": {"note": "Their pH treats the acid left as if it were strong.", "ask": "Is the leftover acid strong or weak? What else is in the flask with it?"}, "PKA_TYPED_AS_PH": {"note": "Their number is -log Ka, the pKa, offered as the pH.", "ask": "Which concentration does pH measure, and is Ka a concentration?"}, "PERCENT_AS_FRACTION": {"note": "Their percent is x ÷ c, not yet multiplied by 100.", "ask": "That is a fraction. What do you multiply it by to make a percent?"}, "SMALL_X_WHEN_IT_FAILS": {"note": "They dropped x, but more than 5 % ionized.", "ask": "What percent does your x give? Is that below 5 %?"}, "POH_TYPED_AS_PH": {"note": "Their pH is the pOH.", "ask": "Your x is [OH⁻]. Does −log x give the pH or the pOH? What is left to do?"}, "IONS_PER_FORMULA_IGNORED": {"note": "Their ion concentration equals the formula concentration though each unit gives more than one ion.", "ask": "How many hydroxide ions does one formula unit release?"}, "RATIO_INVERTED": {"note": "Their ratio, or pH, uses acid left over conjugate made, instead of conjugate over acid.", "ask": "In the Henderson-Hasselbalch equation, which goes on top: the conjugate base or the acid?"}, "LOG_FORGOTTEN": {"note": "Their pH adds the ratio itself to pKa, without the logarithm.", "ask": "What operation sits between pKa and the ratio?"}, "EXCEEDS_INITIAL": {"note": "Their x is larger than the starting concentration.", "ask": "Can more acid ionize than was put in? Check the algebra."}, "WATER_IN_EXPRESSION": {"note": "Water is written into the Ka expression.", "ask": "Water is the solvent. Does it go into Ka?"}, "DILUTION_IONIZATION_FALLS": {"note": "They predicted a smaller fraction ionised on dilution.", "ask": "With the same Ka and fewer molecules per litre, what must happen to the fraction that ionise?"}, "CONJUGATE_LOWERS_PH": {"note": "They predicted the pH falls when the conjugate base is added.", "ask": "The added ion sits on which side of the equation, and which way does that push it?"}, "CONJUGATE_RAISES_PH": {"note": "They predicted the pH rises when the conjugate acid is added to the base.", "ask": "The added ion sits on which side of the equation, and which way does that push it?"}, "BUFFER_PH_FIXED": {"note": "They predicted no change at all after strong acid or base was added.", "ask": "Something was consumed. Did the ratio of base to acid stay exactly the same?"}, "ADDED_NOT_CONSUMED": {"note": "Their new pH treats the added acid or base as if it stayed free in the buffer.", "ask": "What does the added hydroxide meet first in this solution, and what becomes of it?"}, "PH_7_AT_EQUIVALENCE": {"note": "They gave pH 7 at a weak acid's equivalence point.", "ask": "What is left in the flask at equivalence? Can it take a proton from water?"}, "VOLUME_NOT_TOTALED": {"note": "Their concentration divides by the sample's volume only, not the total after the base was added.", "ask": "How much liquid is in the flask now: the sample alone, or the sample plus the base?"}, "KA_FOR_HYDROLYSIS": {"note": "At equivalence they used Ka in place of Kb for the conjugate base.", "ask": "At equivalence the acid is gone. Which species sets the pH, and which constant describes it?"}, "HH_AT_EQUIVALENCE": {"note": "They gave the pKa as the pH at equivalence; that is the halfway point.", "ask": "At equivalence, is there any acid left to make a buffer? When does pH equal pKa?"}, "MOLES_FROM_ONE_SOLUTION": {"note": "Their moles come from one solution's molarity times the wrong volume (for example the total volume).", "ask": "Which volume belongs with which molarity? Moles of acid use the sample's volume and molarity."}}, "trap_notes_by_opener": {}, "equation_symbols": {"x": ["x"], "K": ["Ka", "K_a", "Kb", "K_b", "K"]}, "equation_constants": {"Kw": 1e-14}, "openers": [{"title": "The Vinegar Lab", "question": "In the general chemistry lab, you titrate diluted vinegar with sodium hydroxide while a pH probe records the curve. The phenolphthalein turns pink at about pH 8.7, not at 7, at the very moment the base has used up all the acetic acid. Your lab partner titrates hydrochloric acid of the same concentration, and her curve crosses 7.00 there. Which species are in your flask at the equivalence point, and why do they make it basic?", "model_answer": "At equivalence all CH₃COOH has reacted: CH₃COOH + OH⁻ → CH₃COO⁻ + H₂O. The flask holds Na⁺, CH₃COO⁻ (0.044 M in the total volume) and water. Acetate is a weak base, Kb = Kw ÷ Ka = 5.6 × 10⁻¹⁰: CH₃COO⁻ + H₂O ⇌ CH₃COOH + OH⁻; [OH⁻] ≈ 5.0 × 10⁻⁶ M; pH ≈ 8.70. With HCl, the flask holds Na⁺ and Cl⁻; Cl⁻ is not a base, so the pH is 7.00.", "target": "At a weak acid's equivalence point the solution holds its conjugate base, which takes protons from water; the pH is above 7. A strong acid's equivalence point is at 7.00.", "keywords": ["conjugate base", "acetate", "takes a proton", "hydrolysis", "hydroxide", "Kb", "Kw", "Ka", "spectator", "all the acid used up", "equivalence"], "liquids": ["V1", "V2", "V3", "V4", "V5", "V6"], "kinds": ["weak_at", "strong_at", "weak_start", "weak_before", "weak_after", "strong_before"], "fits": ["V1", "V2", "V3", "V4", "V5", "V6"], "media": {"image_with_question": "ch14_titration/Vinegar_lab.jpg", "image_after_account": "", "image_alt": "A general chemistry lab: a burette over a flask of faint pink liquid on a stir plate, a pH meter reading 8.70, and bottles labeled vinegar and 0.100 M NaOH; students work in the background.", "simulation": "ch14_titration/titration_simulator.html?species={species}&pair={pair}&ca={ca}&va={va}&cb={cb}&vb={vb}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with NotebookLM"}, "label_words": ["titration", "equivalence point", "end point", "indicator", "titration curve", "neutralization"], "role": "worked", "items": {"add": [], "remove": []}}, {"title": "The Kombucha Check", "question": "During a quality-assurance check on raw kombucha, a 20.0 mL aliquot (initial pH 3.1) is titrated against 0.100 M NaOH(aq) to a phenolphthalein endpoint (pH 8.6). Consider the kombucha's organic acidity solely as acetic acid, CH₃COOH. What are the predominant chemical species present in the flask at the equivalence point (exclude water)?", "model_answer": "Predominant: Na⁺ and CH₃COO⁻, each about 0.03 M (all CH₃COOH converted: CH₃COOH + OH⁻ → CH₃COO⁻ + H₂O). Minor, from acetate hydrolysis (CH₃COO⁻ + H₂O ⇌ CH₃COOH + OH⁻, Kb = Kw ÷ Ka = 5.6 × 10⁻¹⁰): CH₃COOH and OH⁻, about 4 × 10⁻⁶ M each; H₃O⁺ about 2.5 × 10⁻⁹ M. The minor OH⁻ sets the pH: about 8.6.", "target": "Titrating a weak acid with a strong base converts it completely to its conjugate base; at equivalence the conjugate base sets a pH above 7, from Kb = Kw ÷ Ka.", "keywords": ["sodium ion", "acetate", "conjugate base", "predominant", "hydroxide", "acetic acid", "trace", "hydrolysis", "Kb", "spectator"], "liquids": ["K1", "K2", "K3", "K4", "K5", "K6"], "kinds": ["weak_at"], "fits": ["K1", "K2", "K3", "K4", "K5", "K6"], "media": {"image_with_question": "ch14_titration/Kombucha_check.jpg", "image_after_account": "", "image_alt": "A brewery lab corner: jars and a glass of amber kombucha behind a burette over a flask of faint pink liquid; a pH meter reads 8.60; bottles labeled 0.100 M NaOH and kombucha sample.", "simulation": "ch14_titration/titration_simulator.html?species={species}&pair={pair}&ca={ca}&va={va}&cb={cb}&vb={vb}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with NotebookLM"}, "label_words": ["titration", "equivalence point", "end point", "indicator", "neutralization", "acidity"], "role": "exam", "items": {"add": [], "remove": []}}, {"title": "The Stockroom Standard", "question": "Before the lab, the stockroom worker checks her 2.0 M hydrochloric acid. She titrates a 10.00 mL sample with 1.000 M sodium hydroxide. The pH meter starts near 0 and climbs slowly for almost 20 mL, then leaps from below 3 to above 11 within a few drops. Which species does each drop of hydroxide react with before the equivalence point, and which species sets the pH after it?", "model_answer": "Before equivalence: OH⁻ + H₃O⁺ → 2H₂O, complete; the excess H₃O⁺ over the total volume sets the pH. At equivalence: Na⁺ and Cl⁻, neither a base nor an acid; pH 7.00. After: excess OH⁻ over the total volume sets the pH. The leap: near equivalence the excess falls from about 10⁻³ M to zero and then rises, so a few drops change the pH by many units (log scale).", "target": "A strong acid titrated with a strong base: before equivalence the excess H₃O⁺ sets the pH, at equivalence the pH is 7.00, after it the excess OH⁻; near equivalence the pH leaps because the excess passes through zero.", "keywords": ["neutralization", "hydronium", "hydroxide", "excess", "total volume", "spectator", "chloride", "sodium", "leap", "logarithm"], "liquids": ["S1", "S2", "S3", "S4", "S5", "S6"], "kinds": ["strong_before", "strong_at", "strong_after"], "fits": ["S1", "S2", "S3", "S4", "S5", "S6"], "media": {"image_with_question": "ch14_titration/Stockroom_standard.jpg", "image_after_account": "", "image_alt": "A stockroom bench: a burette over a flask on a stir plate, a pH probe in the flask with its meter reading 11.40, and bottles labeled 2.0 M HCl and 1.000 M NaOH.", "simulation": "ch14_titration/titration_simulator.html?species={species}&pair={pair}&ca={ca}&va={va}&cb={cb}&vb={vb}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with NotebookLM"}, "label_words": ["titration", "standardization", "equivalence point", "neutralization", "titration curve"], "role": "floater", "items": {"add": [], "remove": []}}, {"title": "The Sour Whey", "question": "A dairy lab measures how much lactic acid has formed in yogurt whey by titrating it with sodium hydroxide. To learn the method, technicians first titrate 10.00 mL of 0.100 M lactic acid with 0.0500 M NaOH. Halfway to the equivalence point, at 10.00 mL, the pH meter reads 3.87, which is the pKa of lactic acid. What species are present in the flask at the halfway point, and why does the pH there equal the pKa?", "model_answer": "Halfway: half the lactic acid has become lactate (HA + OH⁻ → A⁻ + H₂O), so the moles of HA and A⁻ are equal: a buffer with ratio 1. pH = pKa + log([A⁻]/[HA]) = pKa + log 1 = pKa = −log(1.36 × 10⁻⁴) = 3.87. Na⁺ is a spectator. The halfway pH reads Ka off the curve.", "target": "Halfway to a weak acid's equivalence point the acid and its conjugate base are equal, so pH = pKa; the titration curve measures Ka.", "keywords": ["half", "equal moles", "lactate", "lactic acid", "conjugate base", "buffer", "ratio 1", "pKa", "Henderson-Hasselbalch", "neutralization"], "liquids": ["W1", "W2", "W3", "W4", "W5", "W6"], "kinds": ["weak_start", "weak_before", "weak_at", "weak_after"], "fits": ["W1", "W2", "W3", "W4", "W5", "W6"], "media": {"image_with_question": "ch14_titration/Sour_whey.jpg", "image_after_account": "", "image_alt": "A dairy lab bench: a bowl of strained yogurt, a beaker of pale yellow whey, a burette over a colorless flask with a pH probe, a meter reading 3.87, and a bottle labeled 0.100 M lactic acid.", "simulation": "ch14_titration/titration_simulator.html?species={species}&pair={pair}&ca={ca}&va={va}&cb={cb}&vb={vb}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with NotebookLM"}, "label_words": ["titration", "half-equivalence point", "pKa", "buffer", "titration curve"], "role": "floater", "items": {"add": [], "remove": []}}], "moves": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "At the equivalence point, which ions are left in the flask? Can any of them take a proton from water?", "notebook_prompt": "I am learning why a titration's equivalence point is not always at pH 7. Explain which species remain when a weak acid has just been used up by a strong base, and what they do in water. Use an acid other than mine. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words, what is in the flask at the equivalence point?", "park_text": "At equivalence the acid is used up; the flask holds its conjugate base, which takes protons from water and makes the solution basic.", "status": "approved (instructor, 17 Oct 2026)"}, "relation_chosen": {"state": "relation_chosen", "stage": "setup", "label_when_done": "Relation chosen", "ask": "Open the Equations list and pick the relation this region needs.", "switch_ask": "Start: the acid's Ka. Before: Henderson-Hasselbalch. At: the conjugate's Kb from Ka × Kb = Kw. After: the excess base over the total volume.", "notebook_prompt": "Explain which relation gives the pH in each region of a titration, and why. Use a titration other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which relation does each region need?", "park_text": "Start: Ka. Before: Henderson-Hasselbalch. At: Kb = Kw ÷ Ka. After: excess over the total volume.", "status": "approved (instructor, 17 Oct 2026)"}, "region_chosen": {"state": "region_chosen", "stage": "setup", "label_when_done": "Region chosen", "ask": "Compare the moles of base added with the moles of acid in the sample. Where on the curve is this? Pick one.", "switch_ask": "Before equivalence some acid is left; at equivalence the two are equal; after it, base is left over.", "notebook_prompt": "Explain the four regions of a weak acid titration curve and how the moles decide which one you are in. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "How do the moles tell you where you are on the curve?", "park_text": "Compare moles of base added with moles of acid. Less: before. Equal: at. More: after. None: the start.", "status": "approved (instructor, 17 Oct 2026)"}, "moles_found": {"state": "moles_found", "stage": "calculate", "label_when_done": "Moles found", "ask": "Find the moles of acid in the sample and the moles of base added. Type both with their units.", "switch_ask": "Moles = liters × molarity. Convert each volume from mL to L first.", "notebook_prompt": "Show me how to find the moles of acid and base in a titration from their volumes and molarities. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "Why do the moles, not the concentrations, decide the region?", "park_text": "Moles of acid = V(sample, L) × M(acid); moles of base = V(added, L) × M(base).", "status": "approved (instructor, 17 Oct 2026)"}, "table": {"state": "table", "stage": "setup", "label_when_done": "ICE table set up", "ask": "Set up the ICE table for the acid alone: the starting concentration, the change in terms of x, and the equilibrium row. Leave water out.", "switch_ask": "Which species is there at the start, and which two are made?", "notebook_prompt": "Show me how to set up an ICE table for a weak acid in water. Use a different acid and concentration. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "What does each row of an ICE table hold?", "park_text": "Initial: c, 0, 0. Change: −x, +x, +x. Equilibrium: c − x, x, x.", "status": "approved (instructor, 17 Oct 2026)"}, "expression_set": {"state": "expression_set", "stage": "setup", "label_when_done": "Expression written", "ask": "Put the equilibrium row into Ka. Type the equation with x in it.", "switch_ask": "Which species go on top of the fraction, and which on the bottom?", "notebook_prompt": "Explain how to turn the equilibrium row of an ICE table into the equation for x. Use a different acid. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Where does each entry go?", "park_text": "\\( K_a = \\dfrac{x \\cdot x}{c - x} \\)", "status": "approved (instructor, 17 Oct 2026)"}, "method": {"state": "method", "stage": "solve", "label_when_done": "Method chosen", "ask": "How will you solve for x? Pick a method.", "switch_ask": "Is Ka tiny compared with the starting concentration? If x is small, what happens to c − x?", "notebook_prompt": "Explain when you may drop x from c − x, and how the 5 % rule checks it. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "When may you drop x?", "park_text": "Drop x when K is small next to c; check that less than 5 % ionized.", "status": "approved (instructor, 17 Oct 2026)"}, "x_found": {"state": "x_found", "stage": "solve", "label_when_done": "x found", "ask": "Solve for x. Type it with its unit.", "switch_ask": "At the start, x is [H₃O⁺] from Ka. At the equivalence point, x is [OH⁻] from Kb. Which is this?", "notebook_prompt": "Show me how to solve x·x/(c − x) = K for x by dropping x. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "What does x stand for here?", "park_text": "\\( x = \\sqrt{K c} \\) when x is small.", "status": "approved (instructor, 17 Oct 2026)"}, "percent_found": {"state": "percent_found", "stage": "calculate", "label_when_done": "Percent ionized found", "ask": "What percent of the acid ionized? Type the percent.", "switch_ask": "Percent ionized = x ÷ c × 100.", "notebook_prompt": "Explain how to calculate percent ionization, and what it tells you. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What does percent ionized compare?", "park_text": "Percent ionized = x ÷ c × 100.", "status": "approved (instructor, 17 Oct 2026)"}, "approx_checked": {"state": "approx_checked", "stage": "check", "label_when_done": "5 % rule checked", "ask": "Check the 5 % rule. Did dropping x hold? Pick one.", "switch_ask": "Is your percent below 5 or above it?", "notebook_prompt": "Explain the 5 % rule and why it matters. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What does the 5 % rule check?", "park_text": "Below 5 %, dropping x was fine; above, the quadratic was needed.", "status": "approved (instructor, 17 Oct 2026)"}, "ratio_found": {"state": "ratio_found", "stage": "calculate", "label_when_done": "Ratio found", "ask": "Before equivalence, the flask is a buffer. Find the moles of conjugate base made divided by the moles of acid left. Type the ratio.", "switch_ask": "Each mole of base turns one mole of acid into conjugate base. What is left of the acid?", "notebook_prompt": "Explain why the region before equivalence is a buffer, and how to find its base-to-acid ratio from moles. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Why can you use moles in the ratio?", "park_text": "Conjugate made = moles of base added. Acid left = moles of acid − moles of base. Ratio = conjugate ÷ acid left.", "status": "approved (instructor, 17 Oct 2026)"}, "conc_found": {"state": "conc_found", "stage": "calculate", "label_when_done": "Concentration found", "ask": "At equivalence, find the concentration of the conjugate base in the total volume. Type it with its unit.", "switch_ask": "The volume is now the sample plus the base added. Moles of conjugate = moles of acid you started with.", "notebook_prompt": "Explain how to find the conjugate base's concentration at a titration's equivalence point. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which volume do you divide by?", "park_text": "[conjugate] = moles of acid at the start ÷ (sample volume + base volume).", "status": "approved (instructor, 17 Oct 2026)"}, "Kb_found": {"state": "Kb_found", "stage": "calculate", "label_when_done": "Kb found", "ask": "Find Kb of the conjugate base from Ka and Kw. Type its value.", "switch_ask": "Ka × Kb = Kw for a conjugate pair.", "notebook_prompt": "Explain how Ka of a weak acid and Kb of its conjugate base are related, and why. Use an acid other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "How are Ka and Kb of a conjugate pair related?", "park_text": "\\( K_b = \\dfrac{K_w}{K_a} \\)", "status": "approved (instructor, 17 Oct 2026)"}, "excess_conc": {"state": "excess_conc", "stage": "calculate", "label_when_done": "Excess found", "ask": "Find the concentration of the ion in excess, in the total volume. Type it with its unit.", "switch_ask": "Excess moles = the larger amount − the smaller. Then divide by the sample volume plus the base volume.", "notebook_prompt": "Explain how to find the pH from the excess strong acid or base in a titration. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which volume do you divide by?", "park_text": "[excess] = (larger moles − smaller moles) ÷ (sample volume + base volume).", "status": "approved (instructor, 17 Oct 2026)"}, "pOH_found": {"state": "pOH_found", "stage": "calculate", "label_when_done": "pOH found", "ask": "Find the pOH. Type its value.", "switch_ask": "pOH = −log[OH⁻].", "notebook_prompt": "Explain how to get the pOH and the pH from a hydroxide concentration. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which concentration gives the pOH?", "park_text": "\\( \\mathrm{pOH} = -\\log[\\mathrm{OH^-}] \\)", "status": "approved (instructor, 17 Oct 2026)"}, "pH_found": {"state": "pH_found", "stage": "calculate", "label_when_done": "pH found", "ask": "Now find the pH. Type its value.", "switch_ask": "From hydronium: pH = −log[H₃O⁺]. From hydroxide: pH = 14.00 − pOH. From a buffer: pKa + log ratio.", "notebook_prompt": "Show me how to get the pH in each region of a weak acid titration. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "Which relation gave this pH?", "park_text": "Use the relation this region needs: Ka, Henderson-Hasselbalch, Kb, or the excess.", "status": "approved (instructor, 17 Oct 2026)"}, "side_of_7": {"state": "side_of_7", "stage": "inference", "label_when_done": "Side of 7 explained", "ask": "Is this pH above, below, or at 7? Say why, in terms of the species in the flask.", "switch_ask": "Which species decide the pH here: leftover acid, the conjugate base, or excess hydroxide?", "notebook_prompt": "Explain why a weak acid's titration curve sits below 7 before equivalence, above 7 at equivalence, and far above after it. Use an acid other than mine. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What decides the side of 7 here?", "park_text": "Leftover acid: below 7. Conjugate base alone: above 7. Excess hydroxide: well above 7. Strong acid with strong base at equivalence: 7.00.", "status": "approved (instructor, 17 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Near the equivalence point the pH jumps steeply. How do you choose an indicator so that its color change marks that jump?", "switch_ask": "Where does the steep jump sit for a weak acid, and where for a strong acid? Where must the indicator change color?", "notebook_prompt": "Explain how the steep part of a titration curve and the equivalence-point pH decide which acid-base indicator to use. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What must an indicator's color-change range overlap?", "status": "approved (instructor, 17 Oct 2026)"}, "reflection": {"state": "reflection", "stage": "close", "label_when_done": "Reflection written", "ask": "Which step was hardest for you? In one sentence, what would you tell a friend who is stuck there?", "status": "approved (instructor, 17 Oct 2026)"}}, "moves_by_opener": {"The Vinegar Lab": {"meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Methyl red changes color between about pH 4.4 and 6.2. Would it mark the equivalence point of your vinegar titration? Would it work for your partner's hydrochloric acid? Why?", "switch_ask": "Where is your equivalence point, 8.70, compared with methyl red's range? How steep is the HCl curve around 7?", "status": "approved (instructor, 17 Oct 2026)", "show": "An indicator must change color inside the steep jump at equivalence. Vinegar's jump is centered near 8.7, so methyl red (4.4 to 6.2) would change too early, in the buffer region; phenolphthalein (from about 8.2) fits. For HCl the jump runs from about 4 to 10 within a drop or two, so either indicator works. Now answer in your own words."}, "account_given": {"state": "account_given", "status": "approved (instructor, 17 Oct 2026)", "show": "Here is how a chemist would put it: at equivalence the acetic acid is used up, and the flask holds acetate and sodium ions. Acetate is a weak base and takes protons from water, making hydroxide. Now say in your own words which species are in the flask and why it is basic."}, "region_chosen": {"state": "region_chosen", "status": "approved (instructor, 17 Oct 2026)", "show": "Acid: 0.02500 L × 0.0800 M = 0.00200 mol. Base: 0.02000 L × 0.100 M = 0.00200 mol. Equal: this is the equivalence point. Pick it."}, "relation_chosen@v:weak": {"state": "relation_chosen", "status": "approved (instructor, 17 Oct 2026)", "show": "At a weak acid's equivalence point the pH comes from the conjugate base, so you need \\( K_b = K_w \\div K_a \\). Pick Ka × Kb = Kw.", "version": "weak"}, "relation_chosen@v:strong": {"state": "relation_chosen", "status": "approved (instructor, 17 Oct 2026)", "show": "At a strong acid's equivalence point nothing left can take or give a proton, so pH = 7.00. Pick the pH relation.", "version": "strong"}, "moles_found": {"state": "moles_found", "status": "approved (instructor, 17 Oct 2026)", "show": "Acid: 0.02500 L × 0.0800 M = 0.00200 mol. Base: 0.02000 L × 0.100 M = 0.00200 mol. Type both with their units."}, "conc_found@v:weak": {"state": "conc_found", "status": "approved (instructor, 17 Oct 2026)", "show": "All 0.00200 mol of acid became acetate. Total volume: 25.00 + 20.00 = 45.00 mL = 0.04500 L. [acetate] = 0.00200 ÷ 0.04500 = 0.0444 M. Type it with its unit.", "version": "weak"}, "Kb_found@v:weak": {"state": "Kb_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( K_b = 1.0 \\times 10^{-14} \\div 1.8 \\times 10^{-5} = 5.6 \\times 10^{-10} \\). Type Kb.", "version": "weak"}, "x_found@v:weak": {"state": "x_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( x = \\sqrt{5.6 \\times 10^{-10} \\times 0.0444} = 5.0 \\times 10^{-6} \\) M. This x is [OH⁻]. Type it with its unit.", "version": "weak"}, "pOH_found@v:weak": {"state": "pOH_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( \\mathrm{pOH} = -\\log(5.0 \\times 10^{-6}) = 5.30 \\). Type the pOH.", "version": "weak"}, "pH_found@v:weak": {"state": "pH_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( \\mathrm{pH} = 14.00 - 5.30 = 8.70 \\). Type the pH.", "version": "weak"}, "pH_found@v:strong": {"state": "pH_found", "status": "approved (instructor, 17 Oct 2026)", "show": "The flask holds only Na⁺, Cl⁻ and water. Neither ion takes or gives a proton, so pH = 7.00. Type the pH.", "version": "strong"}, "side_of_7@v:weak": {"state": "side_of_7", "status": "approved (instructor, 17 Oct 2026)", "show": "Above 7: acetate, a weak base, takes protons from water and makes hydroxide. Now say it in your own words.", "version": "weak"}, "side_of_7@v:strong": {"state": "side_of_7", "status": "approved (instructor, 17 Oct 2026)", "show": "At 7: chloride is not a base, and sodium is not an acid. Nothing changes the water's own balance. Now say it in your own words.", "version": "strong"}, "offer@v:weak": {"state": "offer", "stage": "close", "status": "approved (instructor, 17 Oct 2026)", "show": "Want to see the same problem with one change? The flask now holds hydrochloric acid at the same concentration and volume, titrated with the same base. Watch where the equivalence point lands.", "version": "weak"}}, "The Kombucha Check": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "Hydroxide is a strong base and acetic acid has a proton to give. What do they form, and what is left once all the acid has reacted?", "park_text": "Each hydroxide takes a proton from acetic acid, making acetate and water. At the end point only acetate and sodium ions remain, and acetate makes the solution basic.", "status": "approved (instructor, 17 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Why does the brewery use phenolphthalein for this titration, and not methyl red, which changes color between pH 4.4 and 6.2?", "switch_ask": "Where is the end point's pH, compared with each indicator's range?", "notebook_prompt": "Explain how to choose an indicator for titrating a weak acid with a strong base. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What must the indicator's range overlap?", "status": "approved (instructor, 17 Oct 2026)"}}, "The Stockroom Standard": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "Hydroxide meets hydronium. What do they make? What is left in the flask once the acid is gone?", "park_text": "Each hydroxide removes one hydronium, making water. Before equivalence leftover hydronium sets the pH; after it, leftover hydroxide does.", "status": "approved (instructor, 17 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Why does the curve climb so slowly for almost 20 mL and then leap by about eight pH units within a few drops?", "switch_ask": "How much hydronium is left one drop before equivalence, and how much hydroxide one drop after? How far apart are those on a log scale?", "notebook_prompt": "Explain why a strong acid–strong base titration curve rises steeply near the equivalence point. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "Why is the jump so steep?", "status": "approved (instructor, 17 Oct 2026)"}}, "The Sour Whey": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "At the halfway point, how much of the lactic acid has been turned into lactate? How do their moles compare?", "park_text": "Halfway, the moles of lactic acid and lactate are equal, so the ratio in the Henderson-Hasselbalch equation is 1 and pH = pKa.", "status": "approved (instructor, 17 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "How could a chemist use the halfway point of a titration curve to find the Ka of an unknown weak acid?", "switch_ask": "What does the pH equal at the halfway point? How do you get Ka from pKa?", "notebook_prompt": "Explain how the half-equivalence point of a titration curve gives the Ka of a weak acid. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What does the halfway pH tell you?", "status": "approved (instructor, 17 Oct 2026)"}}}, "variants": [{"kind": "weak_at", "fixed_id": "V1", "version": "weak", "status": "approved (SCENARIO_CLAUDE's sheet; instructor, 17 Oct 2026)", "tex