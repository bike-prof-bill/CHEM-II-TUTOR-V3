ARCHETYPES_TEST["ch15_common_ion"] = {"contract": 3, "archetype_id": "ch15_common_ion", "title": "The common ion: why a salt dissolves less in a solution that already holds one of its ions", "relation": "Ksp = [cation]^a [anion]^b still holds; an ion already present raises its term, so s must fall", "notebook_url": "https://notebook.google.com/notebook/6458f208-db32-496a-8088-fe0c1c6cd539", "kinds": ["common_cation", "common_anion"], "mechanism_words": ["ion", "lattice", "crystal", "solid", "dissolv", "precipitat", "settle", "collid", "collis", "water", "surround", "pull", "leave", "return", "forward", "reverse", "rate", "equal", "trade", "exchange", "saturat", "molecul", "particl", "hydrat"], "equation_picks": [{"id": "eq_ksp", "text": "\\( K_{sp} = [\\mathrm{M^{m+}}]^{a}[\\mathrm{X^{x-}}]^{b} \\)", "fits": ["common_cation", "common_anion"]}, {"id": "eq_qsp", "text": "\\( Q_{sp} = [\\mathrm{M^{m+}}]_0^{\\,a}[\\mathrm{X^{x-}}]_0^{\\,b} \\)", "fits": []}, {"id": "eq_k", "text": "\\( K = \\dfrac{[\\mathrm{C}]^{c}[\\mathrm{D}]^{d}}{[\\mathrm{A}]^{a}[\\mathrm{B}]^{b}} \\)", "fits": []}, {"id": "eq_ka", "text": "\\( K_a = \\dfrac{[\\mathrm{H_3O^+}][\\mathrm{A^-}]}{[\\mathrm{HA}]} \\)", "fits": []}, {"id": "eq_dil", "text": "\\( M_1 V_1 = M_2 V_2 \\)", "fits": []}, {"id": "eq_g", "text": "\\( \\Delta G^\\circ = -RT \\ln K \\)", "fits": []}], "trap_notes": {"COEFF_NOT_EXPONENT": {"note": "The expression treats the 2 as a multiplier, not an exponent.", "ask": "The ion that appears twice: is its concentration doubled, squared, or both?"}, "EXPONENT_NOT_IN_TABLE": {"note": "The expression has the exponent, but the table gave that ion +x, not +2x.", "ask": "How many of that ion does one formula unit release?"}, "COEFFICIENT_DROPPED_IN_TABLE": {"note": "The table gives +x to an ion that forms two (or n) per unit.", "ask": "One formula unit releases how many of that ion?"}, "ROOT_FORGOTTEN": {"note": "Their x is Ksp divided by the coefficient without the root.", "ask": "What power does x carry in your expression?"}, "COEFFICIENT_FORGOTTEN": {"note": "Their x is the root of Ksp alone: the 4 or the 27 was left out.", "ask": "What multiplies x to the power in your expression?"}, "S_FOR_ION": {"note": "They gave x where the ion's concentration was asked, though two ions form per formula unit.", "ask": "How many of that ion does each dissolved formula unit put into the water?"}, "GRAMS_WITHOUT_MOLAR_MASS": {"note": "Their grams per litre equal the molar solubility: the molar mass was not used.", "ask": "What converts moles per litre into grams per litre?"}, "COMMON_ION_IGNORED": {"note": "Their x is the pure-water value; the common ion was left out.", "ask": "One ion is already in the water. Did your table start it at zero?"}, "SMALL_S_WHEN_IT_FAILS": {"note": "They dropped x, but it is not small next to the term it was dropped from.", "ask": "Compare your answer with the term you dropped it from. Is it under 5 %?"}, "VOLUME_NOT_TOTALED": {"note": "Their concentration after mixing divides by one solution's volume, not the total.", "ask": "How much liquid is in the beaker now?"}, "DILUTION_IGNORED": {"note": "Their concentration after mixing is the concentration before it.", "ask": "Two solutions were poured together. What happened to each one's concentration?"}, "Q_INVERTED": {"note": "Their number is 1/Q.", "ask": "Which concentrations go into Q, and are any divided?"}, "EXPONENTS_DROPPED": {"note": "Their Q has every exponent read as 1.", "ask": "Does every ion in the expression carry an exponent of 1 here?"}, "COEFFICIENTS_AS_MULTIPLIERS": {"note": "Their Q multiplies each concentration by its coefficient instead of raising it to that power.", "ask": "Look at the ion with the coefficient. In the expression, where does that number go?"}, "PRECIPITATE_WHEN_Q_LESS": {"note": "They predicted a precipitate although Q is below Ksp.", "ask": "Is the water holding more than it can, or less?"}, "NO_PRECIPITATE_WHEN_Q_MORE": {"note": "They predicted no precipitate although Q is above Ksp.", "ask": "If Q is larger than Ksp, which way must the ions move?"}, "SOLUBILITY_RISES_WITH_COMMON_ION": {"note": "They predicted more dissolves when a common ion is added.", "ask": "An ion of the solid is added. Does Q go up or down? Which way must the balance move?"}}, "trap_notes_by_opener": {}, "equation_symbols": {"x": ["x", "s"], "K": ["Ksp", "K_sp", "K"]}, "equation_constants": {}, "openers": [{"title": "Washing the Precipitate", "question": "In the stockroom, a technician weighs silver chloride to find how much chloride a sample held, so none of the precipitate may be lost. Rinsed with pure water, some of it dissolves, and a silver-ion electrode in the rinse shows it. Rinsed with dilute sodium chloride instead, the electrode reads thousands of times less. How does the added chloride change the balance between dissolving and settling?", "model_answer": "AgCl(s) ⇌ Ag⁺ + Cl⁻, Ksp 1.6 × 10⁻¹⁰ (Appendix J). Added Cl⁻ (the common ion) raises Q above Ksp; Ag⁺ and Cl⁻ settle until [Ag⁺][Cl⁻] = Ksp again. In 0.10 M Cl⁻, x = [Ag⁺] = Ksp ÷ 0.10 = 1.6 × 10⁻⁹ M, against 1.3 × 10⁻⁵ M in pure water: about 8000 times less. Settling speeds up with more Cl⁻; dissolving does not.", "target": "An ion already present raises Q; the salt dissolves less until the ion product again equals Ksp. Ksp is unchanged; x falls.", "keywords": ["common ion", "chloride", "settle", "dissolve", "Q above Ksp", "Le Châtelier", "silver ion", "less soluble", "collide", "equal rates"], "liquids": ["WP1", "WP2", "WP3", "WP4", "WP5", "WP6"], "kinds": ["common_anion", "common_cation"], "fits": ["WP1", "WP2", "WP3", "WP4", "WP5", "WP6"], "media": {"image_with_question": "ch15/Washing_the_precipitate.jpg", "image_after_account": "", "image_alt": "A lab bench: a funnel holding white silver chloride over a flask, a wash bottle labeled 0.10 M NaCl, and a silver-ion meter reading 1.6E-9 M.", "simulation": "ch15/solubility_simulator.html?mode=common&salt={salt}&common={common}&c_common={c_common}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with Gemini"}, "label_words": ["common-ion effect", "solubility", "Ksp", "precipitate", "Le Châtelier's principle"], "role": "worked", "items": {"add": [], "remove": []}}, {"title": "The Barium Antidote", "question": "A worker accidentally swallows a solution of barium chloride, which dissolves completely and is poisonous. The emergency team gives sodium sulfate by mouth, and a barium test on the stomach contents soon reads far lower. What does the added sulfate do to the free barium ions?", "model_answer": "Na₂SO₄ supplies SO₄²⁻; Ba²⁺ + SO₄²⁻ → BaSO₄(s) until [Ba²⁺][SO₄²⁻] = Ksp = 2.3 × 10⁻⁸ (Appendix J). With sulfate in excess (the common ion), [Ba²⁺] = x = Ksp ÷ [SO₄²⁻]: in 0.10 M sulfate, 2.3 × 10⁻⁷ M, about 660 times less than BaSO₄ in pure water (1.5 × 10⁻⁴ M). The barium leaves the solution as solid.", "target": "With a common ion in excess, x = Ksp ÷ [common ion]; the more of the common ion, the less of the salt dissolves.", "keywords": ["common ion", "sulfate", "precipitate", "barium sulfate", "settle", "less soluble", "Ksp", "solid", "free barium ion", "Q above Ksp"], "liquids": ["BA1", "BA2", "BA3", "BA4", "BA5", "BA6"], "kinds": ["common_anion"], "fits": ["BA1", "BA2", "BA3", "BA4", "BA5", "BA6"], "media": {"image_with_question": "ch15/Barium_antidote.jpg", "image_after_account": "", "image_alt": "A clinic counter: a cup labeled sodium sulfate, a vial labeled Lab Sample with white precipitate at the bottom, and an ion meter reading 2.3E-7 M.", "simulation": "ch15/solubility_simulator.html?mode=common&salt={salt}&common={common}&c_common={c_common}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with Gemini"}, "label_words": ["common-ion effect", "solubility", "Ksp", "precipitate", "antidote"], "role": "exam", "items": {"add": [], "remove": []}}, {"title": "Magnesium from Seawater", "question": "Magnesium metal is made from seawater. Lime is stirred in, and white magnesium hydroxide settles out. Seawater already holds about 0.053 M magnesium ions, and far less magnesium hydroxide stays dissolved in it than in pure water. Why does so little magnesium hydroxide stay dissolved in seawater?", "model_answer": "Mg(OH)₂(s) ⇌ Mg²⁺ + 2OH⁻, Ksp 8.9 × 10⁻¹² (Appendix J). Seawater's Mg²⁺ (0.053 M) is a common cation: [OH⁻] = √(Ksp ÷ 0.053) = 1.3 × 10⁻⁵ M, so x = [OH⁻] ÷ 2 = 6.5 × 10⁻⁶ M, against 1.3 × 10⁻⁴ M in pure water: about 20 times less.", "target": "A common cation lowers the solubility too; for a 1:2 salt, x follows from the squared term of the other ion.", "keywords": ["common ion", "magnesium ion", "hydroxide", "settle", "less soluble", "Ksp", "seawater", "precipitate", "squared"], "liquids": ["SW1", "SW2", "SW3", "SW4", "SW5", "SW6"], "kinds": ["common_anion", "common_cation"], "fits": ["SW1", "SW2", "SW3", "SW4", "SW5", "SW6"], "media": {"image_with_question": "ch15/Magnesium_from_seawater.jpg", "image_after_account": "", "image_alt": "A seaside plant: concrete settling tanks of white magnesium hydroxide slurry beside the sea, and a gloved hand holding a meter reading 0.053 M.", "simulation": "ch15/solubility_simulator.html?mode=common&salt={salt}&common={common}&c_common={c_common}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with Gemini"}, "label_words": ["common-ion effect", "solubility", "Ksp", "precipitate"], "role": "floater", "items": {"add": [], "remove": []}}, {"title": "The Fluoride Rinse", "question": "A dental fluoride rinse contains sodium fluoride. In the lab, calcium fluoride shaken with the rinse dissolves far less than calcium fluoride shaken with plain water: a calcium-ion electrode reads much lower over the rinse. Why does calcium fluoride dissolve less in the rinse?", "model_answer": "CaF₂(s) ⇌ Ca²⁺ + 2F⁻, Ksp 4.0 × 10⁻¹¹ (Appendix J). The rinse's F⁻ is a common anion: x = [Ca²⁺] = Ksp ÷ [F⁻]². In 0.010 M NaF, x = 4.0 × 10⁻⁷ M, against 2.2 × 10⁻⁴ M in pure water: about 540 times less. The squared fluoride makes the effect strong.", "target": "A common ion that is squared in Ksp lowers the solubility especially strongly; when the common ion is dilute, x may not be small next to it.", "keywords": ["common ion", "fluoride", "calcium ion", "squared", "less soluble", "settle", "Ksp", "rinse", "precipitate"], "liquids": ["FR1", "FR2", "FR3", "FR4", "FR5", "FR6"], "kinds": ["common_anion", "common_cation"], "fits": ["FR1", "FR2", "FR3", "FR4", "FR5", "FR6"], "media": {"image_with_question": "ch15/Fluoride_rinse.jpg", "image_after_account": "", "image_alt": "A dental lab bench: a bottle labeled fluoride rinse, two small beakers labeled water and rinse with white powder in each, and a calcium-ion meter reading 4.0E-7 M with its probe in the rinse.", "simulation": "ch15/solubility_simulator.html?mode=common&salt={salt}&common={common}&c_common={c_common}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with Gemini"}, "label_words": ["common-ion effect", "solubility", "Ksp", "fluoride"], "role": "floater", "items": {"add": [], "remove": []}}], "moves": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "One of the solid's ions is already in the water. Does that make leaving the solid easier or harder, and returning to it?", "notebook_prompt": "I am learning the common-ion effect. Explain what an ion already in solution does to a slightly soluble salt, at the particle level. Use a salt other than mine. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words, what does the ion already present do?", "park_text": "The ion already present collides with the solid's surface more often, so settling outpaces dissolving until Ksp holds again: less of the solid stays dissolved.", "status": "approved (instructor, 17 Oct 2026)"}, "relation_chosen": {"state": "relation_chosen", "stage": "setup", "label_when_done": "Ksp relation chosen", "ask": "Open the Equations list and pick the relation for a slightly soluble salt.", "switch_ask": "Which constant is the product of the ion concentrations at saturation?", "notebook_prompt": "Explain what the solubility product, Ksp, is and why the solid is left out. Use a salt other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Why is the solid not in Ksp?", "park_text": "\\( K_{sp} = [\\mathrm{cation}]^a[\\mathrm{anion}]^b \\) at saturation; the solid is not counted.", "status": "approved (instructor, 17 Oct 2026)"}, "table": {"state": "table", "stage": "setup", "label_when_done": "Table set up", "ask": "Set up the table in terms of x. Put the ion that is already present in the starting row.", "switch_ask": "Which ion starts above zero, and at what concentration?", "notebook_prompt": "Show me how to set up a solubility table when one ion is already present. Use a different salt. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "Where does the common ion go in the table?", "park_text": "Start: the common ion at its given concentration, the other at 0. Change: +x (or +2x). End: start + change.", "status": "approved (instructor, 17 Oct 2026)"}, "expression_set": {"state": "expression_set", "stage": "setup", "label_when_done": "Expression written", "ask": "Put the table into Ksp. Type Ksp in terms of x.", "switch_ask": "Each ion's concentration, raised to its count in the formula, including the common ion's starting amount.", "notebook_prompt": "Explain how to write Ksp in terms of x when one ion is already present. Use a different salt. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which term holds the common ion?", "park_text": "Ksp = (common + x)·x, or the matching form for a 1:2 salt.", "status": "approved (instructor, 17 Oct 2026)"}, "method": {"state": "method", "stage": "solve", "label_when_done": "Method chosen", "ask": "How will you solve for x? Pick a method.", "switch_ask": "Is x tiny next to the common ion's concentration? If it is, what can you drop?", "notebook_prompt": "Explain when x may be dropped next to a common ion, and how to check it. Use numbers other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "When may you drop x?", "park_text": "Drop x next to the common ion when it is less than 5 % of it; check afterwards.", "status": "approved (instructor, 17 Oct 2026)"}, "s_found": {"state": "s_found", "stage": "solve", "label_when_done": "Molar solubility found", "ask": "Find the molar solubility with the common ion present. Type it with its unit.", "switch_ask": "With x dropped: Ksp ÷ (common ion term). Without: solve the full expression.", "notebook_prompt": "Show me how to solve for x with a common ion present. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "What does x stand for here?", "park_text": "\\( x = K_{sp} \\div [\\text{common ion}]^{p} \\), p being its count in the formula, if x is small; else solve exactly.", "status": "approved (instructor, 17 Oct 2026)"}, "pure_found": {"state": "pure_found", "stage": "calculate", "label_when_done": "Pure-water solubility found", "ask": "For comparison, find the molar solubility in pure water. Type it with its unit.", "switch_ask": "No ion is present at the start; use the pure-water expression.", "notebook_prompt": "Show me how to find a salt's molar solubility in pure water. Use a different salt. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "How does this compare with your first x?", "park_text": "Pure water: 1:1, x = √Ksp; 1:2, x = ∛(Ksp ÷ 4).", "status": "approved (instructor, 17 Oct 2026)"}, "ratio_found": {"state": "ratio_found", "stage": "calculate", "label_when_done": "Ratio found", "ask": "How many times smaller is the solubility with the common ion? Type the number.", "switch_ask": "Divide the pure-water x by the x with the common ion.", "notebook_prompt": "Explain how to compare two solubilities as a ratio. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which x goes on top?", "park_text": "Ratio = x(pure water) ÷ x(common ion).", "status": "approved (instructor, 17 Oct 2026)"}, "perturb_1": {"state": "perturb_1", "stage": "change", "label_when_done": "More common ion predicted", "ask": "More of the common ion is added. What happens to the amount of solid that dissolves: does it rise, fall, or stay the same? Pick one.", "switch_ask": "More of the shared ion raises Q again. Which way does the balance move?", "notebook_prompt": "Explain what happens when more of a common ion is added. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which way does the solubility move?", "park_text": "More common ion raises Q above Ksp; ions settle until Q = Ksp, so the solubility falls further.", "status": "approved (instructor, 17 Oct 2026)"}, "perturb_1_why": {"state": "perturb_1_why", "stage": "change", "label_when_done": "More common ion explained", "ask": "Explain, in terms of the ions at the solid's surface, why less dissolves.", "switch_ask": "Which process speeds up when more of the shared ion collides with the solid?", "notebook_prompt": "Explain the common-ion effect in terms of rates. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What speeds up?", "park_text": "Settling speeds up with more of the shared ion; dissolving does not, so less stays in solution.", "status": "approved (instructor, 17 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Why does an ion that is already in the water make a salt less soluble, even though Ksp has not changed?", "switch_ask": "What stays fixed: Ksp, or each ion's concentration?", "notebook_prompt": "Explain why the common-ion effect changes solubility but not Ksp. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What stays the same, and what changes?", "status": "approved (instructor, 17 Oct 2026)"}, "reflection": {"state": "reflection", "stage": "close", "label_when_done": "Reflection written", "ask": "Which step was hardest for you? In one sentence, what would you tell a friend who is stuck there?", "status": "approved (instructor, 17 Oct 2026)"}}, "moves_by_opener": {"Washing the Precipitate": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "The rinse already holds chloride. Does that make it easier or harder for silver ions to stay in the water?", "park_text": "Chloride in the rinse collides with the solid and with silver ions, so settling outpaces dissolving until [Ag⁺][Cl⁻] = Ksp again; with plenty of chloride, very little silver stays dissolved.", "status": "approved (instructor, 17 Oct 2026)", "show": "Here is how a chemist would put it: chloride already in the rinse raises Q above Ksp, so silver and chloride settle until [Ag⁺][Cl⁻] = Ksp; very little silver stays dissolved. Now say it in your own words."}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Why does an analyst rinse a precipitate with a dilute solution that shares one of its ions, rather than with pure water?", "switch_ask": "Which rinse leaves more silver dissolved, and why?", "status": "approved (instructor, 17 Oct 2026)", "show": "A rinse that shares an ion keeps Q at Ksp with very little of the solid dissolving; pure water would dissolve thousands of times more. Ksp is the same; x is not. Now answer in your own words."}, "relation_chosen": {"state": "relation_chosen", "status": "approved (instructor, 17 Oct 2026)", "show": "Pick \\( K_{sp} = [\\mathrm{Ag^+}][\\mathrm{Cl^-}] \\). Ksp has not changed; only the starting chloride has."}, "table@v:core": {"state": "table", "status": "approved (instructor, 17 Oct 2026)", "show": "Ag⁺: 0, +x, x. Cl⁻: 0.10, +x, 0.10 + x.", "version": "core"}, "table@v:variant": {"state": "table", "status": "approved (instructor, 17 Oct 2026)", "show": "Ag⁺: 0, +x, x. Cl⁻: 1.0 × 10⁻⁵, +x, 1.0 × 10⁻⁵ + x.", "version": "variant"}, "expression_set@v:core": {"state": "expression_set", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( 1.6 \\times 10^{-10} = x\\,(0.10 + x) \\). Type it.", "version": "core"}, "expression_set@v:variant": {"state": "expression_set", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( 1.6 \\times 10^{-10} = x\\,(1.0 \\times 10^{-5} + x) \\). Type it.", "version": "variant"}, "method@v:core": {"state": "method", "status": "approved (instructor, 17 Oct 2026)", "show": "x will be about 10⁻⁹, tiny next to 0.10: drop it. Pick the small-x method.", "version": "core"}, "method@v:variant": {"state": "method", "status": "approved (instructor, 17 Oct 2026)", "show": "x will be near 10⁻⁵, the same size as the chloride: it cannot be dropped. Pick the exact method.", "version": "variant"}, "s_found@v:core": {"state": "s_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( x = 1.6 \\times 10^{-10} \\div 0.10 = 1.6 \\times 10^{-9} \\) M. Type it with its unit.", "version": "core"}, "s_found@v:variant": {"state": "s_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( x^2 + 1.0 \\times 10^{-5} x - 1.6 \\times 10^{-10} = 0 \\), so \\( x = 8.6 \\times 10^{-6} \\) M. Type it with its unit.", "version": "variant"}, "pure_found": {"state": "pure_found", "status": "approved (instructor, 17 Oct 2026)", "show": "In pure water, \\( x = \\sqrt{1.6 \\times 10^{-10}} = 1.3 \\times 10^{-5} \\) M. Type it."}, "ratio_found@v:core": {"state": "ratio_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( 1.3 \\times 10^{-5} \\div 1.6 \\times 10^{-9} = 7.9 \\times 10^{3} \\): about 8000 times smaller. Type it.", "version": "core"}, "ratio_found@v:variant": {"state": "ratio_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( 1.3 \\times 10^{-5} \\div 8.6 \\times 10^{-6} = 1.5 \\): only 1.5 times smaller. Type it.", "version": "variant"}, "perturb_1": {"state": "perturb_1", "status": "approved (instructor, 17 Oct 2026)", "show": "More chloride raises Q again; silver chloride settles, so less dissolves. Pick the answer."}, "perturb_1_why": {"state": "perturb_1_why", "status": "approved (instructor, 17 Oct 2026)", "show": "More chloride means more collisions that rebuild the solid; settling outpaces dissolving until Q = Ksp. Now explain it in your own words."}, "offer@v:core": {"state": "offer", "stage": "close", "status": "approved (instructor, 17 Oct 2026)", "show": "Want to see the same problem with one change? The rinse now holds only 1.0 × 10⁻⁵ M chloride, about as much as the silver chloride itself puts in. Watch whether x can still be dropped.", "version": "core"}}, "The Barium Antidote": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "Sulfate meets free barium ions. What can they form, and how much barium can stay free alongside a lot of sulfate?", "park_text": "Sulfate and barium ions form barium sulfate, which settles out; with sulfate in excess, only Ksp ÷ [SO₄²⁻] of barium can stay dissolved.", "status": "approved (instructor, 17 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "The antidote turns a dangerous dissolved ion into a harmless solid. Why does more sulfate leave less barium in solution, even though Ksp never changes?", "switch_a