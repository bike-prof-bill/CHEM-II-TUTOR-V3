ARCHETYPES_TEST["ch10_cc"] = {"contract": 3, "archetype_id": "ch10_cc", "title": "Clausius-Clapeyron", "relation": "ln(P2/P1) = -(dHvap/R) * (1/T2 - 1/T1)", "notebook_url": "https://notebook.google.com/notebook/6458f208-db32-496a-8088-fe0c1c6cd539", "kinds": ["T2", "P2", "T1", "P1", "dH", "slope"], "mechanism_words": ["molecul", "particl", "atom", "ion", "electron", "collid", "collis", "energ", "attract", "escap", "vapor", "vapour", "condens", "surface", "kinetic", "bond", "force", "fraction", "distribut", "attach", "stick", "hold", "pull", "grip", "bound", "tied"], "equation_picks": [{"id": "eq_a", "text": "ln(P2/P1) = -(ΔH/R)(1/T2 - 1/T1)", "fits": ["T1", "T2", "P1", "P2", "dH"]}, {"id": "eq_b", "text": "ln P = -(ΔH/R)(1/T) + C", "fits": ["slope"]}, {"id": "eq_c", "text": "ln(k2/k1) = -(Ea/R)(1/T2 - 1/T1)", "fits": []}, {"id": "eq_g", "text": "ln(K2/K1) = -(ΔH°/R)(1/T2 - 1/T1)", "fits": []}, {"id": "eq_d", "text": "PV = nRT", "fits": []}, {"id": "eq_e", "text": "q = m c ΔT", "fits": []}, {"id": "eq_f", "text": "P = X P°", "fits": []}], "trap_notes": {"RECIPROCAL_NOT_TAKEN": {"note": "The answer equals 1/T (a small number such as 0.0017) in place of T.", "ask": "That number is 1/T. What is one more step to get T?"}, "RATIO_NOT_SCALED": {"note": "They typed the ratio of the two pressures as if it were the pressure asked for. A ratio has no unit; the unknown pressure is the known pressure times (or divided by) that ratio.", "ask": "That number is a ratio of two pressures. It has no unit. How do you use the pressure you know to get the one you are finding?"}, "CELSIUS_NOT_CONVERTED": {"note": "Their number is what results when a temperature is left in degC.", "ask": "Look at the temperatures you put into 1/T. What scale are they on, and what scale does the relation need?"}, "KJ_WITH_R_IN_J": {"note": "Their number is what results when dHvap in kJ meets R in J.", "ask": "Write out the units of ΔHvap and of R side by side. Do they cancel?"}, "SIGN_FLIPPED": {"note": "Their number is what results when the negative sign is lost or the ratio is inverted without it.", "ask": "Should your answer be higher or lower than the pressure you were given? Check your signs, and check which pressure goes with which temperature."}, "LOG10_FOR_LN": {"note": "Their number is what results from log base 10 in place of the natural log.", "ask": "Which logarithm does this relation use, and which key did you press?"}, "PRESSURE_UNITS_MIXED": {"note": "Their number is what results when two pressures in different units are divided as they stand.", "ask": "What are the units of each pressure in your ratio?"}, "EQ_SIGN_FLIPPED": {"note": "Their rearranged equation holds only if the negative sign is dropped, or the ratio is inverted without it.", "ask": "Follow the negative sign through each step of your rearrangement. Where does it end up?"}, "EQ_LOG_BASE": {"note": "Their equation holds only with log base 10. 'log' is read as base 10; 'ln' as natural.", "ask": "Which logarithm does this relation use, and which one did you write?"}, "SLOPE_SIGN_KEPT": {"note": "They kept the slope's negative sign on dHvap.", "ask": "Does it take energy or release energy for a molecule to leave the liquid, and what sign does that give ΔHvap?"}, "ONE_ATM_IN_TORR_LINE": {"note": "They set P = 1 in a line fitted with P in torr.", "ask": "In what units was P when this line was fitted, and what is the normal boiling pressure in those units?"}, "KPA_IN_TORR_LINE": {"note": "They set P = 101.325 in a line fitted with P in torr.", "ask": "In what units was P when this line was fitted?"}, "WATER_DH_USED": {"note": "The head pressure matches what water's heat of vaporization from the substance table (40.66 kJ/mol) gives in place of the sealed liquid's.", "ask": "Which liquid is sealed inside the glass? Look again at the heat of vaporization you used."}}, "trap_notes_by_opener": {"The Syringe Boiling Trick": {"SIGN_FLIPPED": {"note": "The answer sits on the wrong side of the known pressure: what a dropped minus sign gives, and crossing the pairs gives the same number. (P_WRONG_SIDE in the scenario's own terms = SIGN_FLIPPED on the pressure kinds.)", "ask": "Think about the syringe. Pulling the plunger lowers the pressure. Should your answer be higher or lower than the pressure you were given? Check your signs. Check which pressure goes with which temperature."}}, "The Drinking Bird": {"SIGN_FLIPPED": {"note": "The head pressure came out higher than the body pressure: a dropped minus sign or crossed pairs.", "ask": "Think about the bird. The head is cooler than the body. Should the pressure in the head be higher or lower than in the body? Check your signs. Check which pressure goes with which temperature."}}, "The Deep-Sea Vent": {"SIGN_FLIPPED": {"note": "The boiling temperature came out below 100 °C: a dropped minus sign, often the one in front of 1/T.", "ask": "Does your answer make sense? More water presses down at depth. Should water boil at a higher or lower temperature there? The term you are isolating has a minus sign in front of it. Did you lose it?"}}}, "equation_symbols": {"T1": ["T1", "T_1", "t1"], "T2": ["T2", "T_2", "t2"], "P1": ["P1", "P_1", "p1"], "P2": ["P2", "P_2", "p2"], "dH": ["ΔHvap", "ΔH_vap", "ΔHv", "ΔH", "dHvap", "dH_vap", "dH", "Hvap", "DHvap", "DH"], "m": ["slope", "m"], "b": ["intercept", "b"], "P": ["P"], "T": ["Tbp", "T_b", "Tb", "T"]}, "equation_constants": {"R": 8.314}, "openers": [{"title": "The Bulging Sunlit Bottle", "question": "A half-empty sealed water bottle left in a hot parked car swells taut, while a pressure sensor detects a sharp spike in overhead gas. What are the surface water particles doing in response to rising temperature that forces so many more molecules into the vapor space?", "model_answer": "Higher thermal energy shifts the kinetic energy distribution so an exponentially larger fraction of liquid molecules possess sufficient energy to overcome intermolecular attractions and vaporize.", "target": "Clausius-Clapeyron exponential increase of vapor pressure with temperature", "keywords": ["kinetic energy", "distribution", "fraction", "overcome", "intermolecular attractions", "vaporize"], "liquids": ["water"], "kinds": [], "fits": ["water"], "media": {"image_with_question": "", "image_after_account": "", "image_alt": "", "simulation": "", "simulation_opens": "meaning", "credit": ""}, "label_words": [], "role": "floater", "items": {"add": [], "remove": []}}, {"title": "The Boiling Bell Jar Flash", "question": "Unheated lukewarm water inside a vacuum chamber suddenly bubbles and boils furiously, tracked by a headspace pressure sensor. What are the energetic water particles doing at the liquid boundary that enables them to lift into vapor without any added heat?", "model_answer": "Vapor pressure equals the lowered external atmospheric pressure, allowing molecules throughout the liquid to overcome the containment barrier and nucleate vapor bubbles.", "target": "Boiling point definition as vapor pressure equaling atmospheric pressure", "keywords": ["vapor pressure", "atmospheric pressure", "barrier", "nucleate", "bubbles", "vaporize"], "liquids": ["water"], "kinds": [], "fits": ["water"], "media": {"image_with_question": "", "image_after_account": "", "image_alt": "", "simulation": "", "simulation_opens": "meaning", "credit": ""}, "label_words": [], "role": "floater", "items": {"add": [], "remove": []}}, {"title": "The Crushed Cooled Flask", "question": "Sealing steam inside a rigid glass jug and plunging it into cold water causes the walls to implode, recorded by an internal barometer. What are the bouncing vapor particles doing against the cold glass surfaces that collapses overhead pressure so violently?", "model_answer": "Cooling reduces molecular kinetic energy, causing vapor molecules colliding with cold walls to lose energy, condense into liquid, and deplete the vapor phase.", "target": "Dynamic condensation and vapor pressure collapse upon cooling", "keywords": ["kinetic energy", "condense", "collisions", "deplete", "liquid", "cooling"], "liquids": ["water"], "kinds": [], "fits": ["water"], "media": {"image_with_question": "", "image_after_account": "", "image_alt": "", "simulation": "", "simulation_opens": "meaning", "credit": ""}, "label_words": [], "role": "floater", "items": {"add": [], "remove": []}}, {"title": "The Ten-Degree Vapor Surge", "question": "Warming perfume water ten degrees doubles the overhead vapor reading on a volatile sensor, far surpassing the minor jump in thermal motion. What are the liquid molecules doing internally to yield such a disproportionately massive surge of vapor from a modest temperature bump?", "model_answer": "The Maxwell-Boltzmann distribution causes the proportion of particles with energy exceeding the enthalpy of vaporization to grow exponentially rather than linearly with temperature.", "target": "Non-linear Maxwell-Boltzmann tail growth driving Clausius-Clapeyron behavior", "keywords": ["Maxwell-Boltzmann", "exponential", "enthalpy of vaporization", "fraction", "distribution", "proportion"], "liquids": ["ethanol"], "kinds": [], "fits": ["ethanol"], "media": {"image_with_question": "", "image_after_account": "", "image_alt": "", "simulation": "", "simulation_opens": "meaning", "credit": ""}, "label_words": [], "role": "floater", "items": {"add": [], "remove": []}}, {"title": "The Sealed Syringe Standoff", "question": "Pulling back the plunger of a sealed syringe containing liquid water momentarily drops pressure before an electronic gauge shows it climbing right back to its original value. What are the surface liquid particles doing in the expanded chamber to restore the exact starting pressure?", "model_answer": "Molecules evaporate faster than vapor condenses until dynamic equilibrium is re-established, restoring the equilibrium vapor pressure characteristic of that specific temperature.", "target": "Equilibrium vapor pressure as an intensive, volume-independent property at constant temperature", "keywords": ["equilibrium", "evaporate", "condenses", "restore", "dynamic", "temperature"], "liquids": ["water"], "kinds": [], "fits": ["water"], "media": {"image_with_question": "", "image_after_account": "", "image_alt": "", "simulation": "", "simulation_opens": "meaning", "credit": ""}, "label_words": [], "role": "floater", "items": {"add": [], "remove": []}}], "moves": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "What would a pressure gauge above the liquid read as it warms and what must the molecules at the surface be doing to cause that?", "notebook_prompt": "I am studying why the vapor pressure of a liquid rises so steeply with temperature. Explain what the molecules at the surface are doing, using a liquid I have not named. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words what did the notebook show you about the molecules at the surface?", "status": "approved (instructor, 12 Oct)"}, "relation_chosen": {"state": "relation_chosen", "stage": "setup", "label_when_done": "Relation chosen", "ask": "The problem is on your screen. Open the Equations list and pick the relation that expresses what you just described.", "switch_ask": "Which quantities in this problem were measured and which one is being inferred?", "notebook_prompt": "I need to recognise which equation links vapor pressure, temperature and heat of vaporization, in its two-point form and its straight-line form. Explain what each symbol stands for and when each form is the handy one. Do not solve any problem for me. Then ask me one short question and wait.", "return_ask": "What does each symbol in the relation you need stand for?", "park_text": "The relation is ln(P2/P1) = -(ΔHvap/R)(1/T2 - 1/T1); the straight-line form is ln P = -(ΔHvap/R)(1/T) + C.", "status": "approved"}, "rearranged": {"state": "rearranged", "stage": "setup", "label_when_done": "Rearranged for the unknown", "ask": "Before any numbers go in: rearrange your relation so the quantity you are after stands by itself on one side. Type it out.", "switch_ask": "Which quantity is the one you are after and what is the last operation standing between it and being alone?", "notebook_prompt": "Show me how to rearrange an equation that has a natural log on one side and a difference of reciprocal temperatures on the other so that a chosen variable stands alone. Use symbols different from mine and do not use my numbers. Then give me one short practice rearrangement and wait for my answer.", "return_ask": "What inverse function removes a natural log, and what inverse operation removes a reciprocal?", "status": "approved"}, "T_in_K": {"state": "T_in_K", "stage": "units", "label_when_done": "Temperatures in kelvin", "ask": "What must be true of a temperature before it can go into this relation? Convert and type the kelvin value(s).", "switch_ask": "What would it mean for the molecules if a temperature of zero on your scale were put into 1/T?", "notebook_prompt": "Explain why gas-law and vapor-pressure equations need absolute temperature, using an example I have not named. Do not solve any problem for me. Then ask me one short question and wait.", "return_ask": "Why does this relation need an absolute temperature?", "park_text": "Add 273.15 to each Celsius temperature to get kelvin.", "status": "approved"}, "dH_in_J": {"state": "dH_in_J", "stage": "units", "label_when_done": "ΔHvap in J/mol", "ask": "Look at the units of R and of the heat of vaporization. What has to happen before they meet in one fraction? Convert one of them and type the value with its unit.", "switch_ask": "What units must ΔHvap/R end up with for the equation to balance?", "notebook_prompt": "Explain how to keep energy units consistent between the gas constant R and a heat of vaporization given in kJ/mol. Do not solve any problem for me. Then ask me one short question and wait.", "return_ask": "What did you find about the units of R and ΔHvap?", "park_text": "Either multiply ΔHvap in kJ/mol by 1000 to get J/mol or use R = 0.008314 kJ/(mol K).", "status": "approved"}, "P_same_units": {"state": "P_same_units", "stage": "units", "label_when_done": "Pressures in one unit", "ask": "The two pressures sit in one ratio. What must be true of their units? Convert one and type it.", "switch_ask": "What should the units of P2/P1 be?", "notebook_prompt": "Explain why two pressures in a ratio must share a unit and how atm, torr and kPa relate. Do not solve any problem for me. Then ask me one short question and wait.", "return_ask": "What must be true of two pressures before you divide one by the other?", "park_text": "1 atm = 760 torr = 101.325 kPa. Put both pressures in the same unit.", "status": "approved"}, "substituted": {"state": "substituted", "stage": "solve", "label_when_done": "Values substituted", "ask": "Put your measured values into the relation and show me what you get for each side.", "switch_ask": "Which of your numbers came from an instrument and which are you about to infer?", "notebook_prompt": "Show me how to substitute values into the two-point vapor pressure relation and isolate an unknown, using numbers and a liquid different from mine. Then ask me one short question and wait.", "return_ask": "What is the first thing you will do with your numbers now?", "park_text": "Substitute the kelvin temperatures and the matched pressures and keep ΔHvap and R in matching units. Then isolate the unknown.", "status": "approved"}, "value_found": {"state": "value_found", "stage": "solve", "label_when_done": "Answer found", "ask": "Carry it through. What value do you get and in what units?", "switch_ask": "Before you calculate should the answer be larger or smaller than the value you were given and why?", "notebook_prompt": "Explain how to isolate an unknown from an equation with a natural log on one side and reciprocal temperatures on the other, using an example different from mine. Then ask me one short question and wait.", "return_ask": "Which step of the algebra was blocking you?", "park_text": "Isolate the unknown: exponentiate both sides for a pressure; solve for 1/T and take the reciprocal for a temperature.", "status": "approved (instructor, 12 Oct)"}, "rearranged_dH": {"state": "rearranged_dH", "stage": "setup", "label_when_done": "Rearranged for ΔHvap", "ask": "Before any numbers: write ΔHvap in terms of the slope of your line. Type the equation with ΔHvap by itself on one side.", "switch_ask": "Set your straight line beside the relation you picked. Which group of symbols sits where the slope sits?", "notebook_prompt": "Show me how to rearrange a straight-line equation of the form ln(y) = m(1/x) + b for a chosen variable, and how a slope can stand for a physical quantity. Use symbols different from mine and no numbers of mine. Then give me one short practice rearrangement and wait for my answer.", "return_ask": "Which part of the relation plays the part of the slope?", "status": "approved"}, "dH_found": {"state": "dH_found", "stage": "solve", "label_when_done": "ΔHvap from the slope", "ask": "What does the slope of your line stand for and what heat of vaporization does it give? Type the value with its unit.", "switch_ask": "If the line were steeper what would that say about how hard it is for a molecule to leave the liquid?", "notebook_prompt": "Explain how the slope of a plot of the natural logarithm of P against 1/T gives the heat of vaporization, using data different from mine. Do not solve my problem. Then ask me one short question and wait.", "return_ask": "How does the slope connect to the heat of vaporization?", "park_text": "Slope = -ΔHvap/R so ΔHvap = -(slope)(R).", "status": "approved"}, "rearranged_T": {"state": "rearranged_T", "stage": "setup", "label_when_done": "Rearranged for T", "ask": "Now rearrange your line so that T stands by itself on one side. Type it.", "switch_ask": "What would the gauge read at the normal boiling point and where does that reading go in your line?", "notebook_prompt": "Show me how to rearrange a straight-line equation of the form ln(y) = m(1/x) + b for a chosen variable, and how a slope can stand for a physical quantity. Use symbols different from mine and no numbers of mine. Then give me one short practice rearrangement and wait for my answer.", "return_ask": "What inverse operation removes a reciprocal, and in what order do you clear the terms around 1/T?", "status": "approved"}, "bp_found": {"state": "bp_found", "stage": "solve", "label_when_done": "Normal boiling point found", "ask": "What defines the normal boiling point and where is that on your line? Type the temperature with its unit.", "switch_ask": "What would a pressure gauge read above the liquid at the moment it boils in an open beaker at sea level?", "notebook_prompt": "Explain what the normal boiling point means in terms of vapor pressure and how to find it from a straight-line fit of the natural logarithm of P against 1/T, using data different from mine. Then ask me one short question and wait.", "return_ask": "What condition defines the normal boiling point?", "park_text": "Set P to 760 torr in your line and solve for T.", "status": "approved"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Look back at your result. What does it let you claim about molecules you never saw and how sure can you be?", "switch_ask": "What did the instrument actually measure and what did you infer from it?", "notebook_prompt": "Help me think about what a vapor pressure measurement lets a chemist infer about molecules in the liquid and what it cannot. Do not give me a finished answer. Ask me one short question and wait.", "return_ask": "What is the difference between what was measured and what was inferred?", "status": "approved (instructor, 12 Oct)"}, "direction_predicted": {"state": "direction_predicted", "stage": "setup", "label_when_done": "Direction predicted", "ask": "Before any math, compare the two temperatures. Will the pressure you are finding be higher or lower than the pressure you were given? Pick one.", "switch_ask": "Think about the molecules at the surface. At the lower of your two temperatures, do more or fewer of them have enough energy to escape?", "notebook_prompt": "I need to predict how the vapor pressure of a liquid changes when its temperature changes, before I calculate anything. Explain what the molecules are doing and which way the pressure goes. Use a liquid I have not named. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What did the notebook show you about temperature and vapor pressure?", "park_text": "Vapor pressure goes up when temperature goes up. It goes down when temperature goes down. In a cooler liquid, fewer molecules have enough energy to escape.", "status": "approved"}, "reflection": {"state": "reflection", "stage": "close", "label_when_done": "Reflection written", "ask": "Which step was hardest for you? In one sentence, what would you tell a friend who is stuck there?", "status": "approved"}, "dP_found": {"state": "dP_found", "stage": "solve", "label_when_done": "Pressure difference found", "ask": "Now compare the two ends of the bird. How much higher is the pressure in the body than in the head? Type the difference with its unit.", "switch_ask": "You have the pressure in the warm body and the pressure in the cool head. Which is larger, and by how much?", "notebook_prompt": "I need to find the difference between two vapor pressures in a sealed container that is warm at one end and cool at the other. Explain what that difference means and how to find it. Use numbers different from mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What does the difference between the two pressures tell you?", "park_text": "Subtract: the pressure in the body minus the pressure in the head.", "status": "approved"}, "value_found@P1;P2": {"state": "value_found@P1;P2", "stage": "solve", "label_when_done": "Answer found", "ask": "Carry it through to the pressure you are finding. If you have the natural logarithm of a pressure ratio, what inverse function removes it? Type the pressure with its unit.", "switch_ask": "Look at the prediction pinned on your screen. Does your number agree with it?", "notebook_prompt": "Show me how to solve an equation like ln(x/a) = b for x. Use letters and numbers different from mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "What inverse function removes the natural logarithm? And what do you do after that to get the pressure you are finding?", "park_text": "Exponentiate both sides: \\(e^{\\ln(x)} = e^{y}\\), which simplifies to \\(x = e^{y}\\). Here x is the ratio of the two pressures. Then solve that ratio for the pressure you are finding.", "status": "approved (instructor, 10 Oct: the scenarios' texts become the default for pressure problems)"}, "direction_predicted@T1;T2": {"state": "direction_predicted@T1;T2", "stage": "setup", "label_when_done": "Direction predicted", "ask": "Before any math, compare the two pressures. Will the temperature you are finding be higher or lower than the temperature you were given? Pick one.", "switch_ask": "Think about a bubble trying to form. Under more pressure, do the molecules need more energy or less to push it open?", "notebook_prompt": "I need to predict how the boiling point of a liquid changes when the pressure on it changes, before I calculate anything. Explain what the molecules are doing and which way the boiling point goes. Use a liquid I have not named. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What did the notebook show you about pressure and boiling point?", "park_text": "Boiling point goes up when the pressure goes up. The molecules need more energy to push a bubble open.", "status": "approved"}, "P_from_depth": {"state": "P_from_depth", "stage": "units", "label_when_done": "Pressure at depth found", "ask": "How hard does the water press at the vent? Use the depth to find the pressure. Type it with its unit.", "switch_ask": "Picture the column of water above the vent. Each 10 m of it adds about 1 atm. What does the air above the sea add?", "notebook_prompt": "Explain how the pressure under water grows with depth, and why the air above the water counts too. Use a depth different from mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What did the notebook show you about pressure and depth?", "park_text": "Pressure = 1 atm from the air + 1 atm for every 10 m of water.", "status": "approved"}, "value_found@T1;T2": {"state": "value_found@T1;T2", "stage": "solve", "label_when_done": "Answer found", "ask": "Carry it through to the temperature. If you have 1/T, what is one more step? Type the temperature with its unit.", "switch_ask": "Look at the prediction pinned on your screen. Does your number agree with it?", "notebook_prompt": "Show me how to solve an equation like 1/x = a - b for x, and how to check that the answer makes sense. Use numbers different from mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "What is the last step to get T from 1/T?", "park_text": "Solve for 1/T first. Then take the reciprocal: T = 1 ÷ (your value of 1/T). Convert to °C if the problem asks for it.", "status": "approved (temperature version; archetype default for temperature problems, instructor 10 Oct)"}, "value_found@dH": {"state": "value_found@dH", "stage": "solve", "label_when_done": "Answer found", "ask": "Carry it through to ΔHvap. Type the value with its unit.", "switch_ask": "Does your answer make sense? Most liquids in our table need 25 to 45 kJ/mol to vaporize. Is yours in that range?", "notebook_prompt": "Show me how to solve an equation like ln(a) = -(x/R)(b - c) for x. Use numbers different from mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "Which step of the algebra was blocking you?", "park_text": "Divide ln(P2/P1) by (1/T2 - 1/T1). Multiply by -R. Give ΔHvap in kJ/mol.", "status": "approved (ΔHvap version; archetype default for dH problems, instructor 10 Oct)"}}, "moves_by_opener": {"The Syringe Boiling Trick": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "A pressure gauge inside the syringe would read lower after you pull the plunger. What does that lower pressure let the water molecules do?", "notebook_prompt": "I am learning why a liquid can boil without being heated. Explain what the molecules in a liquid are doing when it boils. Explain why lowering the pressure above a liquid can make it boil. Use a liquid other than water. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words, what did the notebook show you about why lower pressure lets a liquid boil?", "park_text": "When the external pressure on a liquid drops to its vapor pressure, molecules inside the liquid can form bubbles of vapor. The liquid boils. No heat is needed.", "status": "approved", "show": "Pulling the plunger lowers the external pressure on the water. When the external pressure falls to the water's vapor pressure, molecules inside the liquid have enough energy to push open bubbles of vapor, so the water boils with no heat added. Now say it back in your own words: what are the molecules doing?"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "The pressure you found is the pressure inside the syringe at the moment the liquid starts to boil. What does it tell you about the molecules? How sure can you be?", "switch_ask": "We used one value of ΔHvap for every temperature between your two temperatures. If that is not quite true, how far can you trust the pressure you found?", "status": "approved"}, "direction_predicted": {"state": "direction_predicted", "status": "approved (instructor, 12 Oct: show cell)", "show": "At a lower temperature, fewer molecules have enough energy to escape, so the vapor pressure is lower. The pressure you are finding goes with the lower temperature. So: is it higher or lower than the pressure you were given? Pick one."}, "relation_chosen": {"state": "relation_chosen", "status": "approved (instructor, 12 Oct: show cell)", "show": "This problem links two pressures to two temperatures for one liquid. That is the Clausius-Clapeyron equation: ln(P2/P1) = (ΔHvap/R)(1/T1 − 1/T2). Pick it from the Equations list."}, "rearranged": {"state": "rearranged", "status": "approved (instructor, 12 Oct: show cell)", "show": "Call the pressure you are finding P2, and its temperature T2. Exponentiate both sides: \\(e^{\\ln(x)} = e^{y}\\), which simplifies to \\(x = e^{y}\\). Here x is P2/P1. Then multiply by P1: \\(P_2 = P_1\\, e^{(\\Delta H_{vap}/R)(1/T_1 - 1/T_2)}\\). Type it on one line."}, "T_in_K": {"state": "T_in_K", "status": "approved (instructor, 12 Oct: show cell)", "show": "The equation needs kelvin: T in K = T in °C + 273.15. Convert each temperature. Type the values with K."}, "dH_in_J": {"state": "dH_in_J", "status": "approved (instructor, 12 Oct: show cell)", "show": "R is 8.314 J/(mol·K), so ΔHvap must be in J/mol too. Multiply kJ/mol by 1000. Type ΔHvap in J/mol."}, "P_same_units": {"state": "P_same_units", "status": "approved (instructor, 12 Oct: show cell)", "show": "Both pressures must be in the same unit: 1 atm = 760 torr. Convert the one you were given into the unit the problem asks for. Type it with its unit."}, "substituted": {"state": "substituted", "status": "approved (instructor, 12 Oct: show cell)", "show": "Work out the exponent first: (ΔHvap/R)(1/T1 − 1/T2), with ΔHvap in J/mol, R = 8.314 J/(mol·K) and both temperatures in K. Type its value."}, "value_found": {"state": "value_found", "status": "approved (instructor, 12 Oct: show cell)", "show": "Apply the inverse function, \\(e^{x}\\), to that value. That gives P2/P1. Multiply by P1 to get P2. Type P2 with its unit."}}, "The Drinking Bird": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "A thermometer on the wet head reads a few degrees colder than one on the body. What does the colder glass do to the molecules inside the head?", "notebook_prompt": "I am learning how a drinking bird toy works. Explain what water molecules do when they evaporate from a wet surface. Then explain why a sealed glass container that is cool at one end and warm at the other has a different vapor pressure at each end. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words, what did the notebook show you about the two ends of the bird?", "park_text": "Water evaporating from the felt cools the head. Inside the glass, the cooler head has a lower vapor pressure than the warm body. The higher pressure in the body pushes liquid up the neck.", "status": "approved"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "That difference pushes liquid up the neck. Think of drinking through a straw. In the bird, what acts like your mouth, and what acts like the air pushing down on the drink?", "switch_ask": "Inside the cool head, what are the vapor molecules doing that the ones in the warm body are not?", "status": "approved"}}, "The Deep-Sea Vent": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "A pressure gauge at the vent reads far higher than at the surface. What must the molecules inside a bubble do to push back against that?", "notebook_prompt": "I am learning why very hot water on the deep sea floor does not boil. Explain what molecules must do to form a bubble of vapor inside a liquid. Explain how the pressure on the liquid changes that. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words, what did the notebook show you about pressure and bubbles?", "park_text": "A bubble forms only when the vapor inside it pushes back as hard as the liquid around it. Deep water presses hard, so the water must be much hotter before it can boil.", "status": "approved"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Your temperature is where water starts to boil at that depth. What does it tell you about the water molecules there? How sure can you be?", "switch_ask": "We used water's heat of vaporization at 100 °C for every temperature up to yours. How far can you trust the answer at great depth?", "status": "approved"}}, "The Rubbing Alcohol Chill": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "At the same temperature, a vapor monitor reads much higher over the alcohol than over the water. What does that tell you about how strongly each kind of molecule holds on to its neighbors?", "notebook_prompt": "I am learning why some liquids evaporate faster than others at the same temperature. Explain it in terms of the attractions between molecules. Use liquids other than alcohol and water. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words, what did the notebook show you about why one liquid evaporates faster than another?", "park_text": "Molecules that hold on to their neighbors less strongly escape into vapor more easily. More of them leave each second, so the liquid dries faster and carries more heat away from your skin.", "status": "approved", "show": "The intermolecular forces between alcohol molecules are weaker than those between water molecules. More alcohol molecules have enough kinetic energy to overcome them and escape, so the alcohol evaporates faster and carries heat away from your skin faster. Now say it back in your own words: what are the molecules doing?"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Your ΔHvap is the energy it takes to pull a mole of the liquid's molecules away from their neighbors and into vapor. What does your number tell you about those molecules? How sure can you be?", "switch_ask": "What did the instrument actually measure and what did you infer from it?", "status": "approved"}, "relation_chosen@v:one": {"state": "relation_chosen", "status": "approved (instructor, 12 Oct: show cell)", "show": "This problem links two vapor pressures and two temperatures for one liquid: the Clausius-Clapeyron equation, \\(\\ln\\dfrac{P_2}{P_1} = \\dfrac{\\Delta H_{vap}}{R}\\left(\\dfrac{1}{T_1} - \\dfrac{1}{T_2}\\right)\\). The normal boiling point is one of your two points: there, the vapor pressure is exactly 1 atm. Pick the equation from the Equations list.", "version": "one"}, "relation_chosen@v:two": {"state": "relation_chosen", "status": "approved (instructor, 12 Oct: show cell)", "show": "This problem links two vapor pressures and two temperatures for one liquid: the Clausius-Clapeyron equation, \\(\\ln\\dfrac{P_2}{P_1} = \\dfrac{\\Delta H_{vap}}{R}\\left(\\dfrac{1}{T_1} - \\dfrac{1}{T_2}\\right)\\). This time both points were measured. Pick the equation from the Equations list.", "version": "two"}, "rearranged": {"state": "rearranged", "status": "approved (instructor, 12 Oct: show cell)", "show": "Solve for \\(\\Delta H_{vap}\\): multiply both sides by R, then divide by the temperature term. \\(\\Delta H_{vap} = \\dfrac{R\\,\\ln(P_2/P_1)}{\\left(\\dfrac{1}{T_1} - \\dfrac{1}{T_2}\\right)}\\). Type it on one line."}, "T_in_K": {"state": "T_in_K", "status": "approved (instructor, 12 Oct: show cell)", "show": "The equation needs kelvin: T in K = T in °C + 273.15. Convert each temperature. Type the values with K."}, "P_same_units@v:one": {"state": "P_same_units", "status": "approved (instructor, 12 Oct: show cell)", "show": "Both pressures must be in the same unit. The boiling-point pressure is 1 atm, which is 760 torr. Convert one so the two match. Type it with its unit.", "version": "one"}, "P_same_units@v:two": {"state": "P_same_units", "status": "approved (instructor, 12 Oct: show cell)", "show": "Both pressures must be in the same unit. Any unit works, as long as the two match. Convert one so they do. Type it with its unit.", "version": "two"}, "substituted": {"state": "substituted", "status": "approved (instructor, 12 Oct: show cell)", "show": "Work out the two pieces first: the natural logarithm term, \\(\\ln(P_2/P_1)\\), which has no unit, and the temperature term, \\(\\left(\\dfrac{1}{T_1} - \\dfrac{1}{T_2}\\right)\\), in 1/K. Type either one."}, "value_found": {"state": "value_found", "status": "approved (instructor, 12 Oct: show cell)", "show": "Multiply the natural logarithm term by R = 8.314 J/(mol·K), then divide by the temperature term. That gives \\(\\Delta H_{vap}\\) in J/mol. Divide by 1000 for kJ/mol. Type it with its unit."}, "offer@v:one": {"state": "offer", "ask": "That problem used the normal boiling point as one of its two points. Would you like to see one worked with the same alcohol, where both points are measured: two temperatures and two vapor pressures?", "status": "approved (instructor, 12 Oct: the offer after the reflection)", "version": "one"}}}, "variants": [{"context": {"substance": "water", "one_atm_point": false, "bp_K": 373.15, "lo_K": 313.15, "hi_K": 398.15, "opener": "The Bulging Sunlit Bottle", "items": {"add": [], "remove": []}}, "text": "Water has a vapor pressure of