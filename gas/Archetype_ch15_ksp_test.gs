ARCHETYPES_TEST["ch15_ksp"] = {"contract": 3, "archetype_id": "ch15_ksp", "title": "Ksp: how much of a sparingly soluble salt dissolves", "relation": "Ksp = [cation]^a [anion]^b for the dissolved ions at saturation; the solid is present and not counted; s is the molar solubility", "notebook_url": "https://notebook.google.com/notebook/6458f208-db32-496a-8088-fe0c1c6cd539", "kinds": ["s_from_ksp", "ksp_from_s"], "mechanism_words": ["ion", "lattice", "crystal", "solid", "dissolv", "precipitat", "settle", "collid", "collis", "water", "surround", "pull", "leave", "return", "forward", "reverse", "rate", "equal", "trade", "exchange", "saturat", "molecul", "particl", "hydrat"], "equation_picks": [{"id": "eq_ksp", "text": "\\( K_{sp} = [\\mathrm{M^{m+}}]^{a}[\\mathrm{X^{x-}}]^{b} \\)", "fits": ["s_from_ksp", "ksp_from_s"]}, {"id": "eq_qsp", "text": "\\( Q_{sp} = [\\mathrm{M^{m+}}]_0^{\\,a}[\\mathrm{X^{x-}}]_0^{\\,b} \\)", "fits": []}, {"id": "eq_k", "text": "\\( K = \\dfrac{[\\mathrm{C}]^{c}[\\mathrm{D}]^{d}}{[\\mathrm{A}]^{a}[\\mathrm{B}]^{b}} \\)", "fits": []}, {"id": "eq_ka", "text": "\\( K_a = \\dfrac{[\\mathrm{H_3O^+}][\\mathrm{A^-}]}{[\\mathrm{HA}]} \\)", "fits": []}, {"id": "eq_dil", "text": "\\( M_1 V_1 = M_2 V_2 \\)", "fits": []}, {"id": "eq_g", "text": "\\( \\Delta G^\\circ = -RT \\ln K \\)", "fits": []}], "trap_notes": {"COEFF_NOT_EXPONENT": {"note": "The expression treats the 2 as a multiplier, not an exponent.", "ask": "The ion that appears twice: is its concentration doubled, squared, or both?"}, "EXPONENT_NOT_IN_TABLE": {"note": "The expression has the exponent, but the table gave that ion +x, not +2x.", "ask": "How many of that ion does one formula unit release?"}, "COEFFICIENT_DROPPED_IN_TABLE": {"note": "The table gives +x to an ion that forms two (or n) per unit.", "ask": "One formula unit releases how many of that ion?"}, "ROOT_FORGOTTEN": {"note": "Their x is Ksp divided by the coefficient, without the root.", "ask": "If 4x³ equals Ksp, what do you do after dividing by 4?"}, "COEFFICIENT_FORGOTTEN": {"note": "The 4 (or 27) is left out of x or Ksp.", "ask": "Where does the 4 come from in x(2x)²?"}, "S_FOR_ION": {"note": "They gave x where the concentration of the doubled ion (2x) was asked.", "ask": "Which ion forms twice per unit? Is its concentration x or 2x?"}, "GRAMS_WITHOUT_MOLAR_MASS": {"note": "Grams per liter and moles per liter are swapped.", "ask": "Which number are grams, and which are moles? What links them?"}, "COMMON_ION_IGNORED": {"note": "Their x is the pure-water solubility: the ion already present was not counted.", "ask": "What concentration of that ion was in the water before any solid dissolved?"}, "SMALL_S_WHEN_IT_FAILS": {"note": "They dropped x next to the common ion, but x is not small next to it here.", "ask": "Compare your x with the concentration already present. Is it small next to it?"}, "VOLUME_NOT_TOTALED": {"note": "Their concentration after mixing divides by one solution's volume, not the total.", "ask": "How much liquid is in the beaker now?"}, "DILUTION_IGNORED": {"note": "Their concentration after mixing is the concentration before it.", "ask": "Two solutions were poured together. What happened to each one's concentration?"}, "Q_INVERTED": {"note": "Their number is 1/Q.", "ask": "Which concentrations go into Q, and are any divided?"}, "EXPONENTS_DROPPED": {"note": "Ksp (or Q) from the ion concentrations with every exponent left out.", "ask": "Is each concentration raised to its count in the formula?"}, "COEFFICIENTS_AS_MULTIPLIERS": {"note": "Their Q multiplies each concentration by its coefficient instead of raising it to that power.", "ask": "Look at the ion with the coefficient. In the expression, where does that number go?"}, "PRECIPITATE_WHEN_Q_LESS": {"note": "They predicted a precipitate although Q is below Ksp.", "ask": "Is the water holding more than it can, or less?"}, "NO_PRECIPITATE_WHEN_Q_MORE": {"note": "They predicted no precipitate although Q is above Ksp.", "ask": "If Q is larger than Ksp, which way must the ions move?"}, "SOLUBILITY_RISES_WITH_COMMON_ION": {"note": "They predicted more dissolves when a common ion is added.", "ask": "An ion of the solid is added. Does Q go up or down? Which way must the balance move?"}}, "trap_notes_by_opener": {}, "equation_symbols": {"x": ["x", "s"], "K": ["Ksp", "K_sp", "K"]}, "equation_constants": {}, "openers": [{"title": "The Barium Milkshake", "question": "Before an X-ray of the stomach, a patient drinks a thick white \"barium milkshake\": barium sulfate stirred into water. Barium ions are poisonous, yet the patient is fine. A conductivity probe in the clear liquid above the settled solid reads less than tap water does. Which species are in solution, and what limits their concentration?", "model_answer": "BaSO₄(s) ⇌ Ba²⁺(aq) + SO₄²⁻(aq); Ksp = [Ba²⁺][SO₄²⁻] = 2.3 × 10⁻⁸ (Appendix J); the solid is not in Ksp. At saturation, dissolving and settling run at equal rates. x = √Ksp = 1.5 × 10⁻⁴ M, so [Ba²⁺] = [SO₄²⁻] = 1.5 × 10⁻⁴ M: too little barium to poison, and few ions to carry current (about 43 µS/cm, below typical tap water). Adding more solid does not raise [Ba²⁺].", "target": "A slightly soluble salt dissolves only until the ion product reaches Ksp; at saturation dissolving and settling run at equal rates, and the molar solubility follows from Ksp and the formula.", "keywords": ["dissolve", "settle", "precipitate", "saturated", "equal rates", "barium ion", "sulfate ion", "Ksp", "molar solubility", "solid not counted"], "liquids": ["MK1", "MK2", "MK3", "MK4", "MK5", "MK6"], "kinds": ["ksp_from_s", "s_from_ksp"], "fits": ["MK1", "MK2", "MK3", "MK4", "MK5", "MK6"], "media": {"image_with_question": "ch15/Barium_milkshake.jpg", "image_after_account": "", "image_alt": "A hospital X-ray room: a glass of thick white barium sulfate suspension with a straw, a beaker labeled barium sulfate (settled) with white solid under clear liquid and a conductivity probe in it, and a meter reading 43 µS/cm.", "simulation": "ch15/solubility_simulator.html?mode=dissolve&salt={salt}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with Gemini"}, "label_words": ["solubility", "Ksp", "saturated", "insoluble", "precipitate", "equilibrium"], "role": "worked", "items": {"add": [], "remove": []}}, {"title": "Milk of Magnesia", "question": "Milk of magnesia is a white suspension of magnesium hydroxide; the label says \"shake well\". After it settles, a pH probe in the clear liquid on top reads about 10.4. Which ions are in the clear liquid, how do their concentrations compare, and why?", "model_answer": "Mg(OH)₂(s) ⇌ Mg²⁺ + 2OH⁻; Ksp = [Mg²⁺][OH⁻]² = x(2x)² = 4x³ = 8.9 × 10⁻¹² (Appendix J); x = 1.3 × 10⁻⁴ M. [Mg²⁺] = x; [OH⁻] = 2x = 2.6 × 10⁻⁴ M (two per formula unit), so pOH 3.58 and pH 10.42. The 2 appears twice: as the coefficient in 2x and as the exponent in Ksp.", "target": "For a salt whose ions come in a 1:2 or 2:1 ratio, one ion's concentration is twice x and is squared in Ksp, so Ksp = 4x³.", "keywords": ["magnesium ion", "hydroxide", "two hydroxide", "twice", "2x", "squared", "Ksp", "molar solubility", "saturated", "dissolve"], "liquids": ["ME1", "ME2", "ME3", "ME4", "ME5", "ME6"], "kinds": ["s_from_ksp"], "fits": ["ME1", "ME2", "ME3", "ME4", "ME5", "ME6"], "media": {"image_with_question": "ch15/Milk_of_magnesia.jpg", "image_after_account": "", "image_alt": "A bathroom counter: a bottle labeled Milk of Magnesia beside a glass with white solid settled under clear liquid, a pH probe in the clear liquid, and a meter reading 10.42.", "simulation": "ch15/solubility_simulator.html?mode=dissolve&salt={salt}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with Gemini"}, "label_words": ["solubility", "Ksp", "saturated", "suspension", "base", "equilibrium"], "role": "exam", "items": {"add": [], "remove": []}}, {"title": "The Kidney Stone", "question": "Most kidney stones are calcium oxalate, a salt that barely dissolves. A lab shakes powdered stone with water. A calcium-ion electrode in the clear liquid climbs, then levels off at a very low reading, and adding more powder does not raise it. Which species are in the liquid, and why does the reading level off?", "model_answer": "CaC₂O₄(s) ⇌ Ca²⁺ + C₂O₄²⁻ (as the monohydrate, Ksp 1.96 × 10⁻⁹, Appendix J). At saturation, dissolving and settling run at equal rates; x = √Ksp = 4.4 × 10⁻⁵ M. More solid adds surface, not concentration: [Ca²⁺][C₂O₄²⁻] stays at Ksp.", "target": "Saturation is a dynamic equilibrium: the ion concentrations are set by Ksp, not by how much solid is present.", "keywords": ["dissolve", "settle", "saturated", "equal rates", "calcium ion", "oxalate", "Ksp", "molar solubility", "level off", "solid not counted"], "liquids": ["KS1", "KS2", "KS3", "KS4", "KS5", "KS6"], "kinds": ["ksp_from_s", "s_from_ksp"], "fits": ["KS1", "KS2", "KS3", "KS4", "KS5", "KS6"], "media": {"image_with_question": "ch15/Kidney_stone.jpg", "image_after_account": "", "image_alt": "A lab bench: small brown kidney stones in a dish with tweezers, a flask of clear water over settled white powder with an electrode labeled calcium-ion electrode in it, and a meter reading 4.4E-5 M.", "simulation": "ch15/solubility_simulator.html?mode=dissolve&salt={salt}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with Gemini"}, "label_words": ["solubility", "Ksp", "saturated", "precipitate", "equilibrium"], "role": "floater", "items": {"add": [], "remove": []}}, {"title": "The Silver Halide Lineup", "question": "The stockroom keeps three pale solids: silver chloride (white), silver bromide (cream) and silver iodide (yellow). Each is shaken with water, and a silver-ion electrode reads the clear liquid above it. The three readings differ by a thousandfold. Which species are in each liquid, and what sets the order of the readings?", "model_answer": "AgX(s) ⇌ Ag⁺ + X⁻; Ksp (Appendix J): AgCl 1.6 × 10⁻¹⁰, AgBr 5.0 × 10⁻¹³, AgI 1.5 × 10⁻¹⁶. For 1:1 salts, x = √Ksp: 1.3 × 10⁻⁵, 7.1 × 10⁻⁷ and 1.2 × 10⁻⁸ M. With the same formula type, the smaller Ksp gives the smaller x, so AgCl > AgBr > AgI. Ksp compares directly only when the formulas match (Ag₂CO₃ has a smaller Ksp than AgCl, yet dissolves more).", "target": "Salts with the same formula type can be ranked by Ksp; salts with different formula types must be compared by x.", "keywords": ["silver ion", "chloride", "bromide", "iodide", "Ksp", "molar solubility", "square root", "same formula", "compare", "saturated"], "liquids": ["SH1", "SH2", "SH3", "SH4", "SH5", "SH6"], "kinds": ["ksp_from_s", "s_from_ksp"], "fits": ["SH1", "SH2", "SH3", "SH4", "SH5", "SH6"], "media": {"image_with_question": "ch15/Silver_halide_lineup.jpg", "image_after_account": "", "image_alt": "A stockroom shelf: three jars labeled AgCl (white powder), AgBr (cream) and AgI (pale yellow), with a silver-ion meter reading 1.3E-5 M.", "simulation": "ch15/solubility_simulator.html?mode=dissolve&salt={salt}&theme={theme}", "simulation_opens": "meaning", "credit": "AI image made by the instructor with Gemini"}, "label_words": ["solubility", "Ksp", "halide", "precipitate", "equilibrium"], "role": "floater", "items": {"add": [], "remove": []}}], "moves": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "What leaves the surface of the solid, and what comes back to it? Do the two ever stop?", "notebook_prompt": "I am learning what happens at the particle level when a slightly soluble salt sits in water. Explain dissolving and settling at saturation. Use a salt other than mine. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "In your own words, what is happening at the surface of the solid?", "park_text": "Ions leave the solid and ions return to it; at saturation the two run at equal rates, so the ion concentrations stay fixed.", "status": "approved (instructor, 17 Oct 2026)"}, "relation_chosen": {"state": "relation_chosen", "stage": "setup", "label_when_done": "Ksp relation chosen", "ask": "Open the Equations list and pick the relation for a slightly soluble salt.", "switch_ask": "Which constant is the product of the ion concentrations at saturation?", "notebook_prompt": "Explain what the solubility product, Ksp, is and why the solid is left out. Use a salt other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Why is the solid not in Ksp?", "park_text": "\\( K_{sp} = [\\mathrm{cation}]^a[\\mathrm{anion}]^b \\) at saturation; the solid is not counted.", "status": "approved (instructor, 17 Oct 2026)"}, "table": {"state": "table", "stage": "setup", "label_when_done": "Table set up", "ask": "Set up the table for the dissolved ions in terms of x, the molar solubility. Leave the solid out.", "switch_ask": "How many of each ion does one formula unit release?", "notebook_prompt": "Show me how to set up a solubility table in terms of x for a salt like CaF2. Use a different salt. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "Why does one ion get 2x?", "park_text": "Each ion gets its count per formula unit times x: x for one, 2x for two.", "status": "approved (instructor, 17 Oct 2026)"}, "expression_set": {"state": "expression_set", "stage": "setup", "label_when_done": "Expression written", "ask": "Put the table into Ksp. Type Ksp in terms of x.", "switch_ask": "Each ion's concentration is raised to its count in the formula. Did you keep both the 2 and the square?", "notebook_prompt": "Explain how to write Ksp in terms of x for a 1:2 salt, and why 2x is squared. Use a different salt. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Where do the 4 and the 27 come from?", "park_text": "1:1: Ksp = x². 1:2 or 2:1: Ksp = x(2x)² = 4x³.", "status": "approved (instructor, 17 Oct 2026)"}, "s_found": {"state": "s_found", "stage": "solve", "label_when_done": "Molar solubility found", "ask": "Find the molar solubility, x. Type it with its unit.", "switch_ask": "Undo the expression: divide by the coefficient, then take the square or cube root. If grams per liter were given, divide by the molar mass.", "notebook_prompt": "Show me how to solve Ksp = 4x³ for x, and how to turn grams per liter into moles per liter. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "Which root do you take, and why?", "park_text": "1:1: x = √Ksp. 1:2: x = ∛(Ksp ÷ 4). From g/L: x = (g/L) ÷ molar mass.", "status": "approved (instructor, 17 Oct 2026)"}, "conc_found": {"state": "conc_found", "stage": "calculate", "label_when_done": "Ion concentrations found", "ask": "Find the concentration of each ion. Type both with their units.", "switch_ask": "The ion that appears twice in the formula has twice x.", "notebook_prompt": "Explain how each ion's concentration follows from x in a salt like Ag2CrO4. Use a different salt. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which ion is 2x here?", "park_text": "[ion] = its count per formula unit × x.", "status": "approved (instructor, 17 Oct 2026)"}, "grams_found": {"state": "grams_found", "stage": "calculate", "label_when_done": "Grams per liter found", "ask": "How many grams dissolve in a liter? Type it with its unit.", "switch_ask": "Grams = moles × molar mass.", "notebook_prompt": "Show me how to turn a molar solubility into grams per liter. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "Which mass do you multiply by?", "park_text": "g/L = x × molar mass.", "status": "approved (instructor, 17 Oct 2026)"}, "ksp_found": {"state": "ksp_found", "stage": "calculate", "label_when_done": "Ksp found", "ask": "Now find Ksp from your ion concentrations. Type its value.", "switch_ask": "Raise each ion's concentration to its count in the formula, then multiply.", "notebook_prompt": "Show me how to find Ksp from a measured solubility. Use numbers other than mine. Do not solve my problem. Then give me one short practice problem and wait for my answer.", "return_ask": "Did you keep every exponent?", "park_text": "\\( K_{sp} = [\\mathrm{cation}]^a[\\mathrm{anion}]^b \\), from x.", "status": "approved (instructor, 17 Oct 2026)"}, "perturb_1": {"state": "perturb_1", "stage": "change", "label_when_done": "Common ion predicted", "ask": "A salt that shares one of these ions is added to the saturated solution. What happens to the amount of solid that dissolves: does it rise, fall, or stay the same? Pick one.", "switch_ask": "Adding one of the ions raises Q above Ksp. Which way does the balance between dissolving and settling move?", "notebook_prompt": "Explain why adding a common ion lowers the solubility of a slightly soluble salt. Use a salt other than mine. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "Which way does a common ion move the solubility?", "park_text": "The added ion raises Q above Ksp; ions settle out until Q = Ksp again, so less of the solid stays dissolved.", "status": "approved (instructor, 17 Oct 2026)"}, "perturb_1_why": {"state": "perturb_1_why", "stage": "change", "label_when_done": "Common ion explained", "ask": "Explain, in terms of the ions colliding with the solid's surface, why less dissolves.", "switch_ask": "With more of one ion in the water, which runs faster: settling or dissolving?", "notebook_prompt": "Explain the common-ion effect in terms of the rates of dissolving and settling. Do not solve my problem. Then ask me one short question and wait for my answer.", "return_ask": "What speeds up when the common ion is added?", "park_text": "More of one ion means more collisions that rebuild the solid; settling outpaces dissolving until Q = Ksp.", "status": "approved (instructor, 17 Oct 2026)"}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "What does Ksp tell you, and what does it not tell you, about how much of a salt dissolves?", "switch_ask": "Can you compare two salts by Ksp alone if their formulas differ?", "notebook_prompt": "Explain what Ksp measures and when two salts can be compared by their Ksp values. Do not solve any problem for me. Then ask me one short question and wait for my answer.", "return_ask": "What does Ksp measure?", "status": "approved (instructor, 17 Oct 2026)"}, "reflection": {"state": "reflection", "stage": "close", "label_when_done": "Reflection written", "ask": "Which step was hardest for you? In one sentence, what would you tell a friend who is stuck there?", "status": "approved (instructor, 17 Oct 2026)"}}, "moves_by_opener": {"The Barium Milkshake": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "The solid sits at the bottom. What leaves its surface, what comes back, and when do the two balance?", "park_text": "Barium sulfate dissolves until [Ba²⁺][SO₄²⁻] = Ksp; then ions leave and return to the solid at equal rates, and only about 1.5 × 10⁻⁴ M of each stays dissolved.", "status": "approved (instructor, 17 Oct 2026)", "show": "Here is how a chemist would put it: barium sulfate dissolves until [Ba²⁺][SO₄²⁻] = Ksp; then ions leave and return to the solid at equal rates. Now say it in your own words."}, "meaning_given": {"state": "meaning_given", "stage": "meaning", "label_when_done": "Meaning stated", "ask": "Doubling the barium sulfate in the glass: does the barium ion concentration double? What does Ksp limit, the amount of solid or the concentration of ions?", "switch_ask": "Once the water is saturated, where does any extra solid go?", "status": "approved (instructor, 17 Oct 2026)", "show": "Ksp limits the product of the ion concentrations, not the amount of solid. Once saturated, extra solid just sits there. Now answer in your own words."}, "relation_chosen": {"state": "relation_chosen", "status": "approved (instructor, 17 Oct 2026)", "show": "For a slightly soluble salt, pick \\( K_{sp} = [\\mathrm{Ba^{2+}}][\\mathrm{SO_4^{2-}}] \\). The solid is not in it."}, "table": {"state": "table", "status": "approved (instructor, 17 Oct 2026)", "show": "One BaSO₄ gives one Ba²⁺ and one SO₄²⁻. Ba²⁺: 0, +x, x. SO₄²⁻: 0, +x, x. No column for the solid."}, "expression_set@v:core": {"state": "expression_set", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( K_{sp} = x \\cdot x = x^2 = 2.3 \\times 10^{-8} \\). Type it.", "version": "core"}, "expression_set@v:variant": {"state": "expression_set", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( K_{sp} = x \\cdot x = x^2 \\). Type it.", "version": "variant"}, "s_found@v:core": {"state": "s_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( x = \\sqrt{2.3 \\times 10^{-8}} = 1.5 \\times 10^{-4} \\) M. Type it with its unit.", "version": "core"}, "s_found@v:variant": {"state": "s_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( x = 0.035 \\div 233.39 = 1.5 \\times 10^{-4} \\) M (grams per liter ÷ molar mass). Type it with its unit.", "version": "variant"}, "grams_found@v:core": {"state": "grams_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( 1.5 \\times 10^{-4} \\times 233.39 = 0.035 \\) g/L. Type it with its unit.", "version": "core"}, "ksp_found@v:variant": {"state": "ksp_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( K_{sp} = (1.5 \\times 10^{-4})^2 = 2.2 \\times 10^{-8} \\). Type it.", "version": "variant"}, "perturb_1": {"state": "perturb_1", "status": "approved (instructor, 17 Oct 2026)", "show": "Added sulfate (a common ion) raises Q above Ksp; ions settle out, so less barium sulfate dis