: "core"}, "conc_found@v:variant": {"state": "conc_found", "status": "approved (instructor, 17 Oct 2026)", "show": "Total volume 10.0 mL. \\( [\\mathrm{Ag^+}] = 1.0 \\times 10^{-3} \\) M; \\( [\\mathrm{Cl^-}] = 1.0 \\times 10^{-8} \\times 9.0 \\div 10.0 = 9.0 \\times 10^{-9} \\) M. Type both.", "version": "variant"}, "Q_found@v:core": {"state": "Q_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( Q = 1.0 \\times 10^{-3} \\times 9.0 \\times 10^{-4} = 9.0 \\times 10^{-7} \\). Type it.", "version": "core"}, "Q_found@v:variant": {"state": "Q_found", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( Q = 1.0 \\times 10^{-3} \\times 9.0 \\times 10^{-9} = 9.0 \\times 10^{-12} \\). Type it.", "version": "variant"}, "verdict@v:core": {"state": "verdict", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( 9.0 \\times 10^{-7} > 1.6 \\times 10^{-10} \\): a precipitate forms. Pick it.", "version": "core"}, "verdict@v:variant": {"state": "verdict", "status": "approved (instructor, 17 Oct 2026)", "show": "\\( 9.0 \\times 10^{-12} < 1.6 \\times 10^{-10} \\): it stays dissolved. Pick it.", "version": "variant"}, "perturb_1": {"state": "perturb_1", "status": "approved (instructor, 17 Oct 2026)", "show": "More chloride raises Q. Pick the answer."}, "perturb_1_why": {"state": "perturb_1_why", "status": "approved (instructor, 17 Oct 2026)", "show": "More chloride means more silver–chloride collisions; once Q passes Ksp, they build solid faster than it dissolves. Now explain it in your own words."}, "offer@v:core": {"state": "offer", "stage": "close", "status": "approved (instructor, 17 Oct 2026)", "show": "Want to see the same problem with one change? The same drop of silver nitrate goes into deionized water, with only 1.0 × 10⁻⁸ M chloride. Watch where Q lands.", "version": "core"}}, "The Kidney Stone Risk": {"account_given": {"state": "account_given", "stage": "opening", "label_when_done": "Particle account given", "switch_ask": "After mixing, wh